\begin{tikzpicture}[scale=1.1, >=stealth]
	% =========================================================
	% 1. ВЕРХНІЙ ГРАФІК: Профіль n_e(x)
	% =========================================================
	\begin{scope}[shift={(0, 3.4)}]
		% Осі координат
		\draw[->] (-0.5, 0) -- (4.2, 0) node[right] {$x$};
		\draw[->] (0, -0.2) -- (0, 2.3) node[above] {$n_e(x)$};

		% Лінійний профіль концентрації плазми n_e(x)
		\draw[very thick, blue!80!black] (0, 0) -- (3.6, 2.0) node[above right] {$n_e(x)$};

		% Горизонтальні рівні критичної та ефективної концентрацій
		\draw[dashed, gray] (0, 1.83) node[left] {\small $n_{\mathrm{кр}}$} -- (3.3, 1.83);
		\draw[dashed, gray] (0, 1.22) node[left] {\small $n_{\mathrm{кр}}\cos^2\theta_1$} -- (2.2, 1.22);
		\draw[dashed, gray] (0, 0.61) node[left] {\small $n_{\mathrm{кр}}\cos^2\theta_2$} -- (1.1, 0.61);

		% Вертикальні пунктирні лінії проекції на нижній графік
		\draw[dotted, red!50!black] (1.1, 0.61) -- (1.1, -3.4);
		\draw[dotted, red] (2.2, 1.22) -- (2.2, -3.4);
		\draw[dotted, red!70!black] (3.3, 1.83) -- (3.3, -3.4);

		% Позначки точок повороту на осі x
		\node[below, font=\small] at (1.1, 0) {$x_{\mathrm{п2}}$};
		\node[below, font=\small] at (2.2, 0) {$x_{\mathrm{п1}}$};
		\node[below, font=\small] at (3.3, 0) {$x_{\mathrm{кр}}$};
	\end{scope}

	% =========================================================
	% 2. НИЖНІЙ ГРАФІК: Плазма та траєкторії променів
	% =========================================================

	% Заповнення області плазми з градієнтом густини
	\fill[left color=cyan!10, right color=cyan!50, opacity=0.7] (0, -2.2) rectangle (4.0, 2.2);
	\draw[thick] (0, -2.2) -- (0, 2.2); % Межа розділу вакуум-плазма (x = 0)

	% Підписи середовищ
	\node[above left] at (0, 2.2) {\small Вакуум ($n_e=0$)};
	\node[above right] at (0, 2.2) {\small Градієнтна плазма};

	% Нормалі до межі розділу (пунктир)
	\draw[dashed, gray!70] (-1.2, 1.0) -- (0.8, 1.0);
	\draw[dashed, gray!70] (-1.2, -0.2) -- (0.8, -0.2);
	\draw[dashed, gray!70] (-1.2, -1.5) -- (0.8, -1.5);

	% --- Промінь 3: Великий кут падіння \theta_2 (Точка повороту x_п2 = 1.1) ---
	% Падаючий та відбитий промені у вакуумі
	\draw[->, thick, red!50!black] (-1.8, 1.8) -- (-0.6, 1.4);
	\draw[thick, red!50!black] (-0.6, 1.4) -- (0, 1.0);
	\draw[->, thick, red!50!black] (0, 1.0) plot[domain=-1:1, variable=\t, samples=30] ({1.1*(1 - \t*\t)}, {1.0 + 0.5*\t});
	\draw[->, thick, red!50!black] (0, 1.5) -- (-0.8, 1.87);
	\draw[thick, red!50!black] (-0.8, 1.87) -- (-1.8, 2.3);

	% --- Промінь 2: Помірний кут падіння \theta_1 (Точка повороту x_п1 = 2.2) ---
	% Падаючий та відбитий промені у вакуумі
	\draw[->, thick, red] (-1.8, 0.6) -- (-0.7, 0.15);
	\draw[thick, red] (-0.7, 0.15) -- (0, -0.2);
	\draw[->, thick, red] (0, -0.2) plot[domain=-1:1, variable=\t, samples=30] ({2.2*(1 - \t*\t)}, {-0.2 + 0.6*\t});
	\draw[->, thick, red] (0, 0.4) -- (-0.8, 0.76);
	\draw[thick, red] (-0.8, 0.76) -- (-1.8, 1.21);

	% --- Промінь 1: Нормальне падіння \theta = 0 (Точка повороту x_кр = 3.3) ---
	\draw[->, thick, red!70!black] (-1.8, -1.5) -- (-0.6, -1.5);
	\draw[thick, red!70!black] (-0.6, -1.5) -- (3.3, -1.5);
	\draw[->, thick, red!70!black] (3.3, -1.55) -- (0.6, -1.55);
	\draw[thick, red!70!black] (0.6, -1.55) -- (-1.8, -1.55);

	% Точки повороту (вузли)
	\node[circle, fill=red!50!black, inner sep=1.3pt, label={[font=\small]right:$T_2$}] at (1.1, 1.0) {};
	\node[circle, fill=red, inner sep=1.3pt, label={[font=\small]right:$T_1$}] at (2.2, -0.2) {};
	\node[circle, fill=red!70!black, inner sep=1.3pt, label={[font=\small]below right:$T_0$}] at (3.3, -1.5) {};

	% Кути падіння
	\draw[->, red!50!black] (-0.6, 1.0) arc (180:156:0.6) node[pos=0.5, left, font=\small] {$\theta_2$};
	\draw[->, red] (-0.6, -0.2) arc (180:153:0.6) node[pos=0.5, left, font=\small] {$\theta_1$};

\end{tikzpicture}
