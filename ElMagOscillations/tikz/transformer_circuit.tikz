\begin{circuitikz}[american inductors, european resistors,  scale=1.0, transform shape]
		% ----------------------------------------------------
		% Coordinates for clean layout and spacing
		% ----------------------------------------------------
		\coordinate (P0) at (0,0);
		\coordinate (P1) at (0,3);
		\coordinate (P2) at (3.6,3);
		\coordinate (P3) at (3.6,0);

		\coordinate (S0) at (5.2,0);
		\coordinate (S1) at (5.2,3);
		\coordinate (S2) at (8.8,3);
		\coordinate (S3) at (8.8,0);

		% ----------------------------------------------------
		% ПЕРВИННЕ КОЛО (Primary Circuit)
		% ----------------------------------------------------
		\draw (P0) to[sV, l=$\emf_1(t)$] (P1)
		           to[R, l=$R_1$] (2.2,3)
		           to[short, i=$I_1$] (P2)
		           to[L, l_=$L_1$, name=L1] (P3) -- (P0);

		% ----------------------------------------------------
		% ФЕРОМАГНІТНЕ ОСЕРДЯ ТА ФАЗУВАННЯ
		% ----------------------------------------------------
		\draw[thick] (4.25, 0.4) -- (4.25, 2.6);
		\draw[thick] (4.55, 0.4) -- (4.55, 2.6);

		% Dot notation (Крапки фазування)
		\node[circle, fill, inner sep=1.3pt] at (3.35, 2.5) {};
		\node[circle, fill, inner sep=1.3pt] at (5.45, 2.5) {};

		% ----------------------------------------------------
		% ВТОРИННЕ КОЛО (Secondary Circuit)
		% ----------------------------------------------------
		\draw (S0) to[L, l_=$L_2$, name=L2] (S1)
		           to[short, i_=$I_2$] (6.6,3)
		           to[R, l_=$R_2$] (S2)
		           to[generic, l_=$Z_{\text{н}}$, v^=$U_2$] (S3) -- (S0);

		% ----------------------------------------------------
		% ВЗАЄМНА ІНДУКТИВНІСТЬ L12
		% ----------------------------------------------------
		\draw[<->, >=Stealth, thick, dashed] (L1.north) to[out=55, in=125] node[above=1cm] {$L_{12}$} (L2.north);

		% ----------------------------------------------------
		% ТЕКСТОВІ ПІДПИСИ (Relative Centering)
		% ----------------------------------------------------
		\node[anchor=south, font=\small\bfseries, color=red!70!black, yshift=18pt, align=center] at (1.8, 3) {Первинна\\ обмотка ($N_1$)};
		\node[anchor=south, font=\small\bfseries, color=blue!70!black, yshift=18pt, align=center] at (7.0, 3) {Вторинна\\ обмотка ($N_2$)};
\end{circuitikz}