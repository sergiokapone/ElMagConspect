\begin{tikzpicture}
    \begin{axis}[
            axis lines=center,
            xlabel={$t$},
            ylabel={$q$},
            x label style={anchor=north west, at={(axis description cs:0.98,0.5)}},
            y label style={anchor=south east, at={(axis description cs:0,0.98)}},
            xmin=0, xmax=10,
            ymin=-1.25, ymax=1.25,
            ticks=none,
            width=10cm,
            height=6cm,
            samples=500
        ]

        \addplot [dashed, domain=0:9.5, thick] {exp(-0.35*x)};
        \addplot [dashed, domain=0:9.5, thick] {-exp(-0.35*x)};
        \addplot [red, thick, domain=0:9.5] {exp(-0.35*x) * cos(deg(2.5*pi*x))};

        \node (top_label) at (axis cs:7.5, 0.75) {$q_m\exp(-\gamma t)$};
        \draw[->, >=stealth, thick] (top_label.west) -- (axis cs:5.2, 0.22);

        \node (bottom_label) at (axis cs:7.8, -0.6) {$-q_m\exp(-\gamma t)$};
        \draw[->, >=stealth, thick] (bottom_label.west) -- (axis cs:4.6, -0.25);

    \end{axis}
\end{tikzpicture}