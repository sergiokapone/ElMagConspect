\begin{tikzpicture}
    \begin{axis}[
        width=0.85\textwidth,
        height=6.5cm,
        axis lines=middle,
        xlabel={$\omega t$},
        ylabel={$\emf(t)$},
        xmin=0, xmax=6.283,
        ymin=-1.3, ymax=1.4,
        xtick={0, 1.5708, 3.1415, 4.7123, 6.283},
        xticklabels={$0$, $\frac{\pi}{2}$, $\pi$, $\frac{3\pi}{2}$, $2\pi$},
        ytick={-1, 0, 1},
        yticklabels={$-\emf_m$, $0$, $\emf_m$},
        grid=both,
        grid style={dashed, gray!30},
        legend pos=outer north east,
        trig format plots=rad
    ]
        \addplot[ultra thick, red, domain=0:2*pi, samples=120] {sin(x)};
        \addlegendentry{$\emf_1(t)$}

        \addplot[ultra thick, green!60!black, domain=0:2*pi, samples=120] {sin(x - 2*pi/3)};
        \addlegendentry{$\emf_2(t)$}

        \addplot[ultra thick, blue, domain=0:2*pi, samples=120] {sin(x - 4*pi/3)};
        \addlegendentry{$\emf_3(t)$}
    \end{axis}
\end{tikzpicture}