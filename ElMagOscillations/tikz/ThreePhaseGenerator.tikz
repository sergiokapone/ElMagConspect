\begin{circuitikz}[>=latex, scale=1.0, thick, european]

    \def\Rin{2.0}
    \def\Rout{2.7}

    % ================= 1. ЗАДНІ ЧАСТИНИ ВИТКІВ =================
    \foreach \a in {60, 70, 80, 90, 100, 110} {
        \draw[thick] (\a+4:\Rout) -- (\a+10-4:\Rin);
    }
    \foreach \a in {-60, -50, -40, -30, -20, -10} {
        \draw[thick] (\a+4:\Rout) -- (\a+10-4:\Rin);
    }
    \foreach \a in {180, 190, 200, 210, 220, 230} {
        \draw[thick] (\a+4:\Rout) -- (\a+10-4:\Rin);
    }

    % ================= 2. ОСЕРДЯ СТАТОРA =================
    \draw[fill=gray!28, even odd rule, thick] (0,0) circle (\Rout) (0,0) circle (\Rin);

    % ================= 3. ПЕРЕДНІ ЧАСТИНИ ВИТКІВ =================
    \foreach \a in {60, 70, 80, 90, 100, 110, 120} {
        \draw[thick] (\a-4:\Rin) to[out=\a+40, in=\a-140] (\a+4:\Rout);
    }
    \foreach \a in {-60, -50, -40, -30, -20, -10, 0} {
        \draw[thick] (\a-4:\Rin) to[out=\a+40, in=\a-140] (\a+4:\Rout);
    }
    \foreach \a in {180, 190, 200, 210, 220, 230, 240} {
        \draw[thick] (\a-4:\Rin) to[out=\a+40, in=\a-140] (\a+4:\Rout);
    }

    % ================= 3б. ДРОТИ ТА РЕЗИСТОРИ (під ротором: магніт закриває дроти, що проходять усередині) =================
    \draw (56:\Rout) -- ++(0, 0.95) |- (8.0, 3.2) node[pos=0.7, above] {$I_1$};
    \draw (124:\Rin) -- (-1.1, 1.2) -- (8.0, 1.2) ;
    \draw (8.0, 3.2) to[R=$Z_1$] (8.0, 1.2);

    \draw (4:\Rout) -| (5, 0.15) node[pos=0.3, above] {$I_2$};
    \draw (-64:\Rin) |- (1.0, -1.2) -- (5, -1.2);
    \draw (5, 0.15) to[R=$Z_2$] (5, -1.2);

    \draw (176:\Rout) -| (-3.6, 0.15) -- (-3.6, -2.5) -- (8.0, -2.5) node[midway, below] {$I_3$};
    \draw (236:\Rin) -- (1.0, -0.15) -- (8.0, -0.15) ;
    \draw (8.0, -0.15) to[R=$Z_3$] (8.0, -2.5);

    % ================= 4. РОТОР: МАГНІТ-БРУСОК І СИЛОВІ ЛІНІЇ ЙОГО ПОЛЯ =================
    % силові лінії поза магнітом йдуть від N до S і густіші біля полюсів;
    % замикаються навколо магніту лише крайні, середні йдуть у статор і повертаються з нього
    \foreach \s in {1, -1} {
        \draw[->, blue!55!black, thin] (\s*0.45,1.3) .. controls (\s*1.95,1.9) and (\s*1.95,-1.9) .. (\s*0.45,-1.3);
        \draw[->, blue!55!black, thin] (\s*0.36,1.3) .. controls (\s*1.40,1.7) and (\s*1.40,-1.7) .. (\s*0.36,-1.3);
        \draw[->, blue!55!black, thin] (\s*0.27,1.3) .. controls (\s*0.95,1.55) and (\s*0.95,-1.55) .. (\s*0.27,-1.3);
    }
    \foreach \x in {-0.18, -0.09, 0, 0.09, 0.18} {
        \draw[->, blue!55!black, thin] (\x,1.3) -- (3.2*\x, {sqrt(4-10.24*\x*\x)});
        \draw[->, blue!55!black, thin] (3.2*\x, {-sqrt(4-10.24*\x*\x)}) -- (\x,-1.3);
    }
    \fill[red!75!white]  (-0.45, 0.00) rectangle (0.45,  1.3);
    \fill[blue!70!white] (-0.45,-1.30) rectangle (0.45,  0.0);
    \draw[thick] (-0.45,-1.3) rectangle (0.45, 1.3);
    % усередині магніту лінії поля йдуть від S до N
    \foreach \x in {-0.38, -0.28, 0.28, 0.38} {
        \draw[->, black!55, thin] (\x,-1.3) -- (\x,1.3);
    }
    \node[white] at (0,  0.65) {\Large\bfseries N};
    \node[white] at (0, -0.65) {\Large\bfseries S};
    \draw[fill=white] (0,0) circle (0.08);

    % ================= 5. ОСІ ТА УГЛИ =================
    \draw[dash dot] (0, 0.35) -- (90:3.3);
    \draw[dash dot] (210:0.35) -- (210:3.3);
    \draw[dash dot] (330:0.35) -- (330:3.3);

    \node[above] at (90:3.3) {\Large I};
    \node[below left] at (210:3.3) {\Large III};
    \node[below right] at (330:3.3) {\Large II};

    \draw[<->] (90:3.0) arc (90:-30:3.0);
    \node at (30:3.4) {$120^\circ$};

    \draw[<->] (90:3.0) arc (90:210:3.0);
    \node at (150:3.4) {$120^\circ$};

    \draw[<->] (210:3.0) arc (210:330:3.0);
    \node at (270:3.4) {$120^\circ$};

    % ================= 6. ПРОВOДИ ТА РЕЗИСТОРИ =================
    % (дроти й резистори намальовано вище, під ротором)

\end{circuitikz}