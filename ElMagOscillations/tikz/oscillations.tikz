% !TeX root = ../../test.tex

% Палітра кольорів
\colorlet{ColorE}{red}
\colorlet{ColorB}{blue!40}
\colorlet{ColorCoil}{cyan!80!black}
\colorlet{ColorMass}{gray}
\colorlet{ColorSwitch}{red}
\colorlet{ColorVelocity}{red!80!black}

% 1. Оголошення ключів (додано scale)
\pgfkeys{
  /spring/.cd,
  numcoils/.store in = \NumCoils,
  aspect/.store in = \springAspect,
  seg length/.store in = \springSegLen,
  amplitude/.store in = \springAmp,
  scale/.store in = \springScale,
  % Значення за замовчуванням
  aspect = 0.3,
  seg length = 2.2mm,
  amplitude = 2.8mm,
  scale = 0.7,
  numcoils=10,
}

% 2. Створення команди \drawLCOscillator[key=val]{фаза}
\NewDocumentCommand{\drawLCOscillator}{O{} m}{%
\begingroup
    \pgfkeys{/spring/.cd, #1}% Приймає та оновлює ключі
\begin{tikzpicture}[>=stealth, font=\large, scale=\springScale, transform shape, baseline={(base)}]

    % --- Головні параметри ---
    \def\Phase{#2}        % Фаза з аргументу #2
    \def\MaxLines{5}     % Максимальна кількість ліній поля
    \def\Amp{1.2}        % Амплітуда (см)
    \def\PlateH{0.12}    % Товщина пластин

    % --- Обчислення ---
    \pgfmathsetmacro{\xnorm}{cos(\Phase)}
    \pgfmathsetmacro{\inorm}{-sin(\Phase)}
    \pgfmathsetmacro{\numE}{int(round(abs(\xnorm) * \MaxLines))}
    \pgfmathsetmacro{\numB}{int(round(abs(\inorm) * \MaxLines))}
    \pgfmathsetmacro{\xShift}{\xnorm * \Amp}
    \pgfmathsetmacro{\xEquil}{2.2}
    \pgfmathsetmacro{\xPos}{\xEquil + \xShift}

    % =========================================================
    % 1. ЕЛЕКТРИЧНИЙ КОНТУР (LC)
    % =========================================================

    % Верхня пластина
    \filldraw[fill=gray!25, draw=black, thick, line join=round]
        (0, 1.2-\PlateH) -- (2.0, 1.2-\PlateH) -- (2.0, 1.2) -- (0, 1.2) -- cycle;
    \filldraw[fill=gray!35, draw=black, thick, line join=round]
        (2.0, 1.2-\PlateH) -- (2.6, 1.6-\PlateH) -- (2.6, 1.6) -- (2.0, 1.2) -- cycle;
    \filldraw[fill=gray!10, draw=black, thick, line join=round]
        (0, 1.2) -- (2.0, 1.2) -- (2.6, 1.6) -- (0.6, 1.6) -- cycle;

    % Нижня пластина
    \filldraw[fill=gray!25, draw=black, thick, line join=round]
        (0, 0.0-\PlateH) -- (2.0, 0.0-\PlateH) -- (2.0, 0.0) -- (0, 0.0) -- cycle;
    \filldraw[fill=gray!35, draw=black, thick, line join=round]
        (2.0, 0.0-\PlateH) -- (2.6, 0.4-\PlateH) -- (2.6, 0.4) -- (2.0, 0.0) -- cycle;
    \filldraw[fill=gray!10, draw=black, thick, line join=round]
        (0, 0.0) -- (2.0, 0.0) -- (2.6, 0.4) -- (0.6, 0.4) -- cycle;

    \node[above left] at (0.6, 1.6) {$C$};

    % Заряди та Електричне поле E
    \ifnum \numE > 0
        \foreach \i in {1,...,\numE} {
            \pgfmathsetmacro{\t}{\i / (\numE + 1)}
            \pgfmathsetmacro{\px}{0.4 + \t * 1.8}

            \ifdim \xShift pt > 0pt
                \node[red, font=\small] at (\px, 1.35) {$+$};
                \node[blue, font=\small] at (\px, 0.25) {$-$};
                \draw[->, thick, ColorE] (\px, 1.15) -- (\px, 0.45);
            \else
                \node[blue, font=\small] at (\px, 1.35) {$-$};
                \node[red, font=\small] at (\px, 0.25) {$+$};
                \draw[->, thick, ColorE] (\px, 0.45) -- (\px, 1.05);
            \fi
        }
        \node[right, ColorE, font=\bfseries] at (2.4, 0.8) {$\mathbf{E}$};
    \fi

    % Провідники контуру
    \draw[thick] (1.3, 1.4) -- (1.3, 2.3) -- (4.2, 2.3);
    \draw[thick] (1.3, -\PlateH) -- (1.3, -0.9) -- (4.2, -0.9);

    % Котушка L
    \draw[thick, ColorCoil, decoration={coil,
        pre length=3pt,  % прибирає хвостик на початку
        post length=0pt,  % прибирає хвостик у кінці
        aspect=0.4,
        segment length=2.7mm,
        amplitude=3.5mm},
        decorate]
        (4.2, 2.3) -- (4.2, -0.9);
    \node[right=8pt] at (4.5, 0.7) {$L$};

    % Магнітне поле B
    \ifnum \numB > 0
        \foreach \j in {1,...,\numB} {
            \pgfmathsetmacro{\offset}{(\j - (\numB+1)/2) * 0.15}
            \pgfmathsetmacro{\bendAngle}{\offset * 25}

            \ifdim \inorm pt > 0pt
                \draw[->, thick, ColorB] (4.2+\offset, -1.5) to[bend left=\bendAngle] (4.2+\offset, 3.0);
            \else
                \draw[->, thick, ColorB] (4.2+\offset, 3.0) to[bend right=\bendAngle] (4.2+\offset, -1.5);
            \fi
        }
        \node[left=4pt, ColorB, font=\bfseries] at (3.9, 0.7) {$\mathbf{B}$};
    \fi

    % Підписи I та q
    \ifnum \numB = 0
        \node[above] at (2.75, 2.3) {$I = 0$};
    \else
        \node[above] at (2.75, 2.3) {$I \neq 0$};
    \fi

    \ifdim \xShift pt > 0pt
        \node[above right] at (2.3, 1.5) {$+q_0$};
        \node[below right] at (2.3, 0.1) {$-q_0$};
    \else\ifdim \xShift pt < 0pt
        \node[above right] at (2.3, 1.5) {$-q_0$};
        \node[below right] at (2.3, 0.1) {$+q_0$};
    \fi\fi

    % =========================================================
    % 2. ПРУЖИННИЙ МАЯТНИК
    % =========================================================
    \begin{scope}[shift={(6.2,0)}]
        \fill[pattern=north east lines] (0,-0.2) rectangle (-0.25, 1.8);
        \draw[thick] (0,-0.2) -- (0, 1.8);

        \coordinate (MassCenter) at (\xPos, 0.5);

        % Рахуємо крок: (загальна довжина L) / N
        \pgfmathsetmacro{\SpringSeg}{(\xPos - 0.5) / \NumCoils}

        % Малюємо пружину
        \draw[thick, decoration={
            coil,
            aspect=\springAspect,
            segment length=\SpringSeg cm,
            amplitude=\springAmp
        }, decorate]
        (0, 0.5) -- (\xPos - 0.5, 0.5); % <-- Додано пропущену ';'

        \draw[thick, fill=ColorMass, rounded corners=1pt]
            (\xPos - 0.5, 0.1) rectangle (\xPos + 0.5, 0.9);
        \node at (MassCenter) {$m$};

        \ifnum \numB = 0
            \node[above=15pt] at (MassCenter) {$v = 0$};
        \else
            \pgfmathsetmacro{\vDir}{sign(\inorm)}
            \draw[->, very thick, ColorVelocity]
                (\xPos, 1.0) -- (\xPos + \vDir*0.7, 1.0)
                node[midway, above] {$v$};
        \fi

        \draw[->, thick] (0, -0.4) coordinate (base)-- (4.2, -0.4) node[below] {$x$};
        \draw[thick] (\xEquil, -0.3) -- (\xEquil, -0.5) node[below=2pt] {\scriptsize $0$};

        \draw[gray, dashed] (\xEquil, -0.3) -- (\xEquil, -1.1);
        \draw[gray, dashed] (\xPos, -0.3) -- (\xPos, -1.1);

        \ifdim \xShift pt = 0pt
        \else
            \draw[<->, >=Latex] (\xEquil, -1) -- (\xPos, -1)
                node[midway, above=-2pt, font=\small] {$x$};
        \fi
    \end{scope}
\end{tikzpicture}%
\endgroup
}

\begin{subfigure}{0.45\linewidth}
    \centering
    \drawLCOscillator[aspect = 0.5]{0}
    \caption{Стан системи при $\phi = 0^\circ$}
\end{subfigure}
\hfill
\begin{subfigure}{0.45\linewidth}
    \centering
    \drawLCOscillator{90}
    \caption{Стан системи при $\phi = 90^\circ$}
\end{subfigure}
\\
\begin{subfigure}{0.45\linewidth}
    \centering
    \drawLCOscillator{180}
    \caption{Стан системи при $\phi = 180^\circ$}
\end{subfigure}
\hfill
\begin{subfigure}{0.45\linewidth}
    \centering
    \drawLCOscillator{270}
    \caption{Стан системи при $\phi = 270^\circ$}
\end{subfigure}