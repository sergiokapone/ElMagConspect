% ---------------- Підрисунок (а): всередині ----------------
\begin{subfigure}[t]{0.48\linewidth}
    \centering
    \begin{tikzpicture}[>=latex, baseline={(0,0)}, scale=2]
        % Основні параметри
        \pgfmathsetmacro\h{2}         % повна висота циліндра
        \pgfmathsetmacro\R{0.5}       % радіус циліндра
        \pgfmathsetmacro\Ry{0.2*\R}   % стиснення еліпса основи
        \pgfmathsetmacro\HL{-0.1*\R}  % межа відблиску

        % Бічна поверхня циліндра (тінь -- відблиск -- тінь)
        \begin{scope}
            \clip (-\R, -\h/2) -- (-\R, \h/2) arc (180:360:{\R} and {\Ry}) -- (\R, -\h/2) arc (0:-180:{\R} and {\Ry});
            \shade[left color=gray!55, right color=gray!12]
                (-\R-0.1, -\h/2-\Ry-0.1) rectangle (\HL, \h/2+0.1);
            \shade[left color=gray!12, right color=gray!78]
                (\HL, -\h/2-\Ry-0.1) rectangle (\R+0.1, \h/2+0.1);
        \end{scope}

        % Вертикальні твірні
        \draw (-\R, -\h/2) -- (-\R, \h/2)
              ( \R, -\h/2) -- ( \R, \h/2);

        % Видима (передня) частина нижньої основи
        \draw (-\R, -\h/2) arc (180:360:{\R} and {\Ry});

        % Верхня основа
        \shade[ball color=gray!20] (0, \h/2) circle ({\R} and {\Ry});
        \draw (0, \h/2) circle ({\R} and {\Ry});

        % Контур всередині
        \draw[thin, green!50!black, arrowpos={0.1}{0pt}{2pt}, fill=green]
            (0,0) [partial ellipse=0:360:{0.4*\R} and {0.1*\R}]
            node[pos=0.1, above] {$L$};

        % Струм
        \draw[->] (0,-0.1) -- ++(0, 0.5) node[above] {$\vect{j}$};
    \end{tikzpicture}
    \caption{Всередині: \( B = \dfrac{2\pi}{c}jr \)}
    \label{fig:cyl_inside}
\end{subfigure}\hfill
% ---------------- Підрисунок (б): зовні ----------------
\begin{subfigure}[t]{0.48\linewidth}
    \centering
    \begin{tikzpicture}[>=latex, baseline={(0,0)}, scale=2]
        % Основні параметри
        \pgfmathsetmacro\h{2}
        \pgfmathsetmacro\R{0.5}
        \pgfmathsetmacro\Ry{0.2*\R}
        \pgfmathsetmacro\HL{-0.1*\R}

        % Бічна поверхня циліндра (тінь -- відблиск -- тінь)
        \begin{scope}
            \clip (-\R, -\h/2) -- (-\R, \h/2) arc (180:360:{\R} and {\Ry}) -- (\R, -\h/2) arc (0:-180:{\R} and {\Ry});
            \shade[left color=gray!55, right color=gray!12]
                (-\R-0.1, -\h/2-\Ry-0.1) rectangle (\HL, \h/2+0.1);
            \shade[left color=gray!12, right color=gray!78]
                (\HL, -\h/2-\Ry-0.1) rectangle (\R+0.1, \h/2+0.1);
        \end{scope}

        % Вертикальні твірні
        \draw (-\R, -\h/2) -- (-\R, \h/2)
              ( \R, -\h/2) -- ( \R, \h/2);

        % Видима (передня) частина нижньої основи
        \draw (-\R, -\h/2) arc (180:360:{\R} and {\Ry});

        % Верхня основа
        \shade[ball color=gray!20] (0, \h/2) circle ({\R} and {\Ry});
        \draw (0, \h/2) circle ({\R} and {\Ry});

        % Зовнішній контур
        \draw[thin, green!50!black, arrowpos={0.1}{0pt}{2pt}]
            (0,0) [partial ellipse=0:360:{0.3*8*\R} and {0.05*8*\R}]
            node[pos=0.1, above] {$L$};

        % Переріз
        \fill[green] (0, 0) circle ({\R} and {\Ry});

        % Струм
        \draw[->] (0,-0.1) -- ++(0, 0.5) node[above] {$\vect{j}$};
    \end{tikzpicture}
    \caption{Зовні: \( B = \dfrac{2I}{cr} \)}
    \label{fig:cyl_outside}
\end{subfigure}