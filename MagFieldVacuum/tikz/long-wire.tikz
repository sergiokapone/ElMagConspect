% !TeX root = ../../test.tex

\begin{tikzpicture}[>=latex, scale=1.4]
    % --- Основні параметри ---
    \pgfmathsetmacro\h{4.2}         % Висота провідника
    \pgfmathsetmacro\R{0.15}        % Радіус провідника
    \pgfmathsetmacro\Ry{0.06}       % Стиснення еліпса основи
    \pgfmathsetmacro\HL{-0.03}      % Межа відблиску
    \pgfmathsetmacro\rContour{2.4}  % Радіус контуру інтегрування (відстань r)
    \pgfmathsetmacro\rContourY{0.48}% Стиснення контуру в перспективі

    \coordinate (O) at (0, 0);
    \coordinate (P) at (\rContour, 0);
    \coordinate (Dl) at (0, -1.3);

    % --- Задня частина контуру інтегрування L (позаду провідника) ---
    \draw[green!60!black, thick, dashed] (0,0) [partial ellipse=0:180:{\rContour} and {\rContourY}];

    % --- Тіло провідника (3D-циліндр з відблиском) ---
    \begin{scope}
        \clip (-\R, -\h/2) -- (-\R, \h/2) arc (180:360:{\R} and {\Ry}) -- (\R, -\h/2) arc (0:-180:{\R} and {\Ry});
        \shade[left color=gray!55, right color=gray!12]
            (-\R-0.1, -\h/2-\Ry-0.1) rectangle (\HL, \h/2+0.1);
        \shade[left color=gray!12, right color=gray!78]
            (\HL, -\h/2-\Ry-0.1) rectangle (\R+0.1, \h/2+0.1);
    \end{scope}

    % Твірні (бічні контурні лінії)
    \draw (-\R, -\h/2) -- (-\R, \h/2);
    \draw ( \R, -\h/2) -- ( \R, \h/2);

    % Нижня основа (видима частина)
    \draw[] (-\R, -\h/2) arc (180:360:{\R} and {\Ry});

    % Верхня основа
    \shade[ball color=gray!20] (0, \h/2) circle ({\R} and {\Ry});
    \draw (0, \h/2) circle ({\R} and {\Ry});

    % --- Червоний циліндричний елемент струму d\ell ---
    \begin{scope}
        \clip (-\R, -1.55) -- (-\R, -1.05) arc (180:360:{\R} and {\Ry}) -- (\R, -1.55) arc (0:-180:{\R} and {\Ry});
        \shade[left color=red!80!black, right color=red!25]
            (-\R-0.05, -1.6) rectangle (\R+0.05, -1.0);
    \end{scope}
    \draw[red!70!black, thin] (-\R, -1.55) -- (-\R, -1.05)
                              ( \R, -1.55) -- ( \R, -1.05);
    \draw[red!70!black, thin] (-\R, -1.55) arc (180:360:{\R} and {\Ry});
    \shade[ball color=red!40] (0, -1.05) circle ({\R} and {\Ry});
    \draw[red!70!black, thin] (0, -1.05) circle ({\R} and {\Ry});

    % Позначення вектора d\ell поруч
    \draw[red!80!black, ->, thick] (-0.35, -1.55) -- (-0.35, -1.05) node[midway, left] {$d\symbfscr{l}$};

    % --- Передня частина контуру інтегрування L (перед провідником) ---
    \draw[green!60!black, thick, arrowpos={0.70}{6pt}{6pt}]
        (0,0) [partial ellipse=180:360:{\rContour} and {\rContourY}]
        node[pos=0.85, below right, green!50!black] {$L$};

    % --- Струм I ---
    \draw[->, thick] (0, \h/2 + 0.1) -- ++(0, 0.6) node[above] {$I$};

    % --- Геометрія та параметризація ---
    % Перпендикуляр r (від осі провідника до точки P)
    \draw[dashed, gray!80!black] (O) -- (P) node[midway, above] {$r$};

    % Позначка прямого кута біля осі O
    \draw[gray!80!black] (0.18, 0) -- (0.18, 0.18) -- (0, 0.18);

    % Відрізок l вздовж провідника
    \draw[<->, thin, gray!80!black] (-0.6, 0) -- (-0.6, -1.3) node[midway, left] {$\ell$};
    \draw[dotted, gray!80!black] (-0.7, 0) -- (0, 0);
    \draw[dotted, gray!80!black] (-0.7, -1.3) -- (0, -1.3);

    % Вектор \mathcal{r} від елемента d\ell до точки P
    \draw[->, thick, blue] (Dl) -- (P) node[midway, below right=-1pt] {$\vect{\mathcal{r}}$};

    % Точка спостереження P
    \fill (P) circle (1.5pt) node[right=4pt] {$P$};

    % --- Кут \alpha між елементом d\ell та вектором \mathcal{r} ---
    % Вершина кута — точка Dl (елемент струму)
    % Перший промінь — вертикально вгору (напрямок струму d\ell)
    % Другий промінь — уздовж вектора \mathcal{r} до точки P
    \pgfmathsetmacro\angAlpha{atan2(2.4, 1.3)} % кут між вертикаллю та \mathcal{r}
    \draw[->, thin, gray!70!black]
        (Dl) ++(90:0.55) arc (90:{90-\angAlpha}:0.55);
    \path (Dl) ++({90-0.5*\angAlpha}:0.85) node {$\alpha$};

    % Вектор магнітного поля dB (напрямлений за площину \otimes)
    \draw[thick] (P) ++(0.35, 0.35) circle (3pt) node[right=4pt] {$d\Bfield$};
    \draw[thick] (P) ++(0.35, 0.35) ++(-2pt,-2pt) -- ++(4pt,4pt);
    \draw[thick] (P) ++(0.35, 0.35) ++(-2pt,2pt) -- ++(4pt,-4pt);
\end{tikzpicture}