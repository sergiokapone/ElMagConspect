% !TeX root = ../../test.tex

\begin{tikzpicture}[>=latex, scale=1.4]
    % --- Параметри циліндра та геометрії ---
    \pgfmathsetmacro\h{3.6}          % Висота суцільної частини циліндра
    \pgfmathsetmacro\R{0.1}          % Радіус провідника
    \pgfmathsetmacro\Ry{0.05}        % Стиснення еліпса основи
    \pgfmathsetmacro\HL{-0.05}       % Межа відблиску
    \pgfmathsetmacro\rDist{2.2}      % Відстань r до точки P
    \pgfmathsetmacro\rContourY{0.45} % Стиснення контуру L у перспективі

    \coordinate (O) at (0, 0);
    \coordinate (A) at (0, -\h/2);
    \coordinate (B) at (0, \h/2);
    \coordinate (P) at (\rDist, 0);
    \coordinate (Dl) at (0, -0.9);

    % --- Задня частина контуру інтегрування L (позаду провідника) ---
    \draw[blue!60!black, thick, dashed] (O) [partial ellipse=0:180:{\rDist} and {\rContourY}];

    % --- Тіло провідника (3D-циліндр з відблиском) ---
    \begin{scope}
        \clip (-\R, -\h/2) -- (-\R, \h/2) arc (180:360:{\R} and {\Ry}) -- (\R, -\h/2) arc (0:-180:{\R} and {\Ry});
        \shade[left color=gray!55, right color=gray!12]
            (-\R-0.1, -\h/2-\Ry-0.1) rectangle (\HL, \h/2+0.1);
        \shade[left color=gray!12, right color=gray!78]
            (\HL, -\h/2-\Ry-0.1) rectangle (\R+0.1, \h/2+0.1);
    \end{scope}

    % Твірні (бічні контурні лінії)
    \draw (-\R, -\h/2) -- (-\R, \h/2);
    \draw ( \R, -\h/2) -- ( \R, \h/2);

    % Нижня основа (видима частина)
    \draw (-\R, -\h/2) arc (180:360:{\R} and {\Ry});

    % Верхня основа
    \shade[ball color=gray!20] (0, \h/2) circle ({\R} and {\Ry});
    \draw (0, \h/2) circle ({\R} and {\Ry});

    % Нескінченне продовження циліндра (пунктир зверху та знизу)
    \draw[gray, densely dashed] (-\R, \h/2) -- (-\R, \h/2 + 0.6);
    \draw[gray, densely dashed] ( \R, \h/2) -- ( \R, \h/2 + 0.6);
    \draw[gray, densely dashed] (-\R, -\h/2) -- (-\R, -\h/2 - 0.6);
    \draw[gray, densely dashed] ( \R, -\h/2) -- ( \R, -\h/2 - 0.6);

    % --- Червоний циліндричний елемент струму d\ell ---
    \begin{scope}
        \clip (-\R, -1.1) -- (-\R, -0.7) arc (180:360:{\R} and {\Ry}) -- (\R, -1.1) arc (0:-180:{\R} and {\Ry});
        \shade[left color=red!80!black, right color=red!25]
            (-\R-0.05, -1.15) rectangle (\R+0.05, -0.65);
    \end{scope}
    \draw[red!70!black, thin] (-\R, -1.1) -- (-\R, -0.7)
                              ( \R, -1.1) -- ( \R, -0.7);
    \draw[red!70!black, thin] (-\R, -1.1) arc (180:360:{\R} and {\Ry});
    \shade[ball color=red!40] (0, -0.7) circle ({\R} and {\Ry});
    \draw[red!70!black, thin] (0, -0.7) circle ({\R} and {\Ry});

    % Стрілка довжини елемента поруч
    \draw[red!80!black, ->, thick] (-0.35, -1.1) -- (-0.35, -0.7) node[midway, left] {$d\symbfscr{l}$};

    % --- Передня частина контуру інтегрування L (перед провідником) ---
    \draw[blue!60!black, thick, arrowpos={0.75}{0pt}{4pt}]
        (O) [partial ellipse=180:360:{\rDist} and {\rContourY}]
        node[pos=0.85, below right] {$L$};

    % --- Точки кінців відрізка провідника A та B ---
    \fill (A) circle (1pt) node[left=2pt] {$A$};
    \fill (B) circle (1pt) node[left=2pt] {$B$};

    % --- Відрізки від кінців A і B до точки P ---
    \draw[gray!80!black, thick] (A) -- (P);
    \draw[gray!80!black, thick] (B) -- (P);

    % --- Кути \alpha_1 та \alpha_2 ---
    % Кут \alpha_1 біля точки A (між напрямком струму вгору та вектором \mathcal{r}_1)
    \pgfmathsetmacro\angA{atan(\rDist/(\h/2))}
    \draw[thin] (A) ++(0, 0.4) arc (90:{90-\angA}:0.4) node[pos=0.6, above right=-2pt] {$\alpha_1$};

    % Кут \alpha_2 біля точки B (між напрямком струму вгору та вектором \mathcal{r}_2)
    \pgfmathsetmacro\angB{atan(\rDist/(\h/2))}
    \draw[thin] (B) ++(0, 0.5) arc (90:{-90+\angB}:0.5) node[pos=0.5, right] {$\alpha_2$};

    % --- Струм I ---
    \draw[->, thick] (0, \h/2 + 0.2) -- ++(0, 0.6) node[above] {$I$};

    % --- Геометрія та параметризація поточного елемента ---
    % Перпендикуляр r від осі до точки P
    \draw[dashed, gray!80!black] (O) -- (P) node[midway, above] {$r$};
    \draw[gray!80!black] (0.15, 0) -- (0.15, 0.15) -- (0, 0.15); % Знак прямого кута

    % Відрізок \ell вздовж провідника
    \draw[<->, thin, gray!80!black] (-0.6, 0) -- (-0.6, -0.9) node[midway, left] {$\ell$};
    \draw[dotted, gray!80!black] (-0.7, 0) -- (0, 0);
    \draw[dotted, gray!80!black] (-0.7, -0.9) -- (0, -0.9);

    % Вектор \mathcal{r} від елемента d\ell до точки P
    \draw[->, thick, blue] (Dl) -- (P) node[midway, below right=-1pt] {$\vect{\mathcal{r}}$};

    % Точка спостереження P
    \fill (P) circle (1.5pt) node[right=3pt] {$P$};

    % --- Кут \alpha між елементом d\ell та вектором \mathcal{r} ---
    % Вершина кута — точка Dl (елемент струму)
    % Перший промінь — вертикально вгору (напрямок струму d\ell)
    % Другий промінь — уздовж вектора \mathcal{r} до точки P
    \pgfmathsetmacro\angAlpha{atan2(\rDist, 0.9)} % кут між вертикаллю та \mathcal{r}
    \draw[->, thin, gray!70!black]
        (Dl) ++(90:0.5) arc (90:{90-\angAlpha}:0.5);
    \path (Dl) ++({90-0.5*\angAlpha}:0.78) node {$\alpha$};

    % Вектор магнітної індукції dB (\otimes — у площину)
    \draw[thick] (P) ++(0.35, 0.35) circle (3pt) node[right=4pt] {$d\Bfield$};
    \draw[thick] (P) ++(0.35, 0.35) ++(-2pt,-2pt) -- ++(4pt,4pt);
    \draw[thick] (P) ++(0.35, 0.35) ++(-2pt,2pt) -- ++(4pt,-4pt);
\end{tikzpicture}