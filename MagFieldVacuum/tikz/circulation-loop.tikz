% Адаптовано з MagFieldVacuum_slides.tex (слайд "Теорема про циркуляцію магнітного поля у вакуумі. Інтегральна форма")
\begin{tikzpicture}[>=latex, scale=0.8, transform shape]
	\draw [in=-105, out=75, looseness=1.25, line width=12pt, gray!50] (-1, -1) coordinate
	(A) to (2, 2) coordinate (B);
	\draw[fill=gray!50, ultra thin, rotate around={-10:(B)}] (B) circle(8.5pt and 2pt);
	\draw[fill=gray!50, ultra thin, rotate around={-10:(A)}] (A) circle(8.5pt and 2pt);
	\draw[thick, green!50!black] (0, 0) circle(1 and 0.3);
	\begin{scope}
		\clip (-1,0) rectangle (1,1);
		\draw [in=-105, out=75, looseness=1.25, line width=12pt, gray!50] (-1, -1) to (2, 2)
		;
	\end{scope}
	\draw[red!20, pattern=crosshatch, pattern color=red!20] (-1,0) to[out=85, in=45,
	looseness=3] node[pos=0.2, above, text=red]
	{$S$} (1, 0) arc(0:-180:1 and 0.3) ;
	\draw[thick, arrowpos={0.5}{3pt}{4pt}, green!50!black] (-1, 0) arc(180:360:1 and 0.3)
	node[pos=0.5, below] {$L$};
\end{tikzpicture}
