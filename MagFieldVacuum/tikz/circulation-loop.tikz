\begin{tikzpicture}[>=latex, scale=1.25, transform shape]
	% Отримуємо масштаб
	\pgfgettransformentries{\sc}{\tmpa}{\tmpb}{\tmpc}{\tmpd}{\tmpe}

	% Автоматичні розміри:
	\pgfmathsetmacro{\lw}{4 * \sc}   % Товщина лінії (змінюйте це значення як завгодно)
	\pgfmathsetmacro{\ra}{\lw / 2.5}  % Радіус торця = точно половина товщини лінії \lw
	\pgfmathsetmacro{\rb}{0.2 * \lw} % Мала піввісь (пропорційна товщині лінії)

	% Основна трубка
	\draw [in=-105, out=75, looseness=1.25, line width=\lw pt, gray!50] (-1, -1) coordinate
	(A) to (2, 2) coordinate (B);

	% Торці з точним кутом перпендикуляра (-15 deg)
	\draw[fill=gray!50, ultra thin, rotate around={-15:(B)}] (B) ellipse (\ra pt and \rb pt);
	\draw[fill=gray!50, ultra thin, rotate around={-15:(A)}] (A) ellipse (\ra pt and \rb pt);

	\draw[thick, green!50!black] (0, 0) ellipse (1 and 0.3);

	% Перекриття трубки над поверхнею
	\begin{scope}
		\clip (-1,0) rectangle (1,1);
		\draw [in=-105, out=75, looseness=1.25, line width=\lw pt, gray!50] (-1, -1) to (2, 2);
	\end{scope}

	\draw[red!20, pattern=crosshatch, pattern color=red!20] (-1,0) to[out=85, in=45,
	looseness=3] node[pos=0.2, above, text=red]
	{$S$} (1, 0) arc(0:-180:1 and 0.3) ;
	\draw[thick, arrowpos={0.5}{3pt}{4pt}, green!50!black] (-1, 0) arc(180:360:1 and 0.3)
	node[pos=0.5, below] {$L$};
\end{tikzpicture}