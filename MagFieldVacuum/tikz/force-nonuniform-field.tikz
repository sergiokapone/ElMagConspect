% Адаптовано з MagFieldVacuum_slides.tex (слайд "Сила, що діє на диполь в магнітному полі")
\begin{tikzpicture}[>=latex, midarrow/.style={%
				postaction={ decorate,
						decoration={ markings, mark=at position .7 with {\arrow{latex}}}}}]
	\foreach \y in {-3,...,3}{
			\draw[blue, midarrow] plot[domain=1:4] (\x, 0.2*\y+0.05*\y*\x^2);
		}
	\coordinate (AP) at (3, 0);
	\pic[scale=0.7, rotate=210] at (AP) {magarrow};
	\draw[->, ultra thick] (AP) -- ++(-1, 0) node[below=2pt, fill=white, inner sep=1pt]
	{$\vect{F}$};
\end{tikzpicture}
