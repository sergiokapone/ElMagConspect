% Адаптовано з Radiation.tex (слайд "Випромінювання заряду")
% Зламані силові лінії поля заряду, що коротко прискорився (модель Дж. Дж. Томсона).
% Усередині оболонки лінії виходять із нового положення заряду, ззовні~--- зі старого.
\begin{tikzpicture}[
        scale=1.5,
		>=latex,
		chp/.style = {
				circle,
				inner sep=1pt,
				ball color=red,
				font=\tiny\mathstrut\bfseries,
				text=white,
				inner sep=0pt
			},
		fline/.style = {
				red!80!black,
				line width=0.9pt
			},
		myarrow/.style = {
				->,
				red!80!black,
				line width=0.9pt
			},
		mytext/.style = {
				align=center,
				font=\small,
				inner sep=0
			}
	]
	\def\r{1.8}
	\def\R{2}
	\def\d{0.5}
	\def\arrowLength{1}
	\def\angles{0,22.5,...,340}

	% оболонка випромінювання (шар завтовшки c\tau)
	\fill[even odd rule, yellow!45] (0,0) circle(\R) (0,0) circle(\r);
	\draw[gray!70!black, thin] (0,0) circle(\r);
	\draw[gray!70!black, thin] (0,0) circle(\R);

	\coordinate (q)  at (0,0);
	\coordinate (q') at (0,\d);

	\begin{scope}
		\clip (q) circle(\r);
		\foreach[count=\i] \angle in \angles {
				\draw[fline, name path global=line\i] (q') -- ++(\angle:{\R + \d});
			}
	\end{scope}
	\path[name path=innerCircle] (q) circle(\r);

	\foreach[count=\i] \angle in \angles {
			\draw[myarrow] (q) ++(\angle:\R) coordinate (endOfLine\i) -- ++(\angle:\arrowLength);
			\draw[fline, name intersections={of=innerCircle and line\i}] (intersection-1) -- (endOfLine\i);
		}

	% заряд: старе (напівпрозоре) і нове положення
	\node[chp, opacity=0.45] at (q) {$+$};
	\node[chp, minimum size=3.5mm] at (q') {$+$};

	\coordinate (innerViewer) at (-40:{\r-0.5});
	\coordinate (outerViewer) at (220:{\R+0.5});
	\coordinate (accRegion) at (265:{(\R+\r)/2});

	\node[mytext] (textOuterViewer) at (200:{\R+1.7}) {Зовнішній\\ спостерігач};
	\draw[->, black!60] (textOuterViewer) to[bend left] (outerViewer);

	\node[mytext] (textInnerViewer) at (-35:{\R+1.7}) {Внутрішній\\ спостерігач};
	\draw[->, black!60] (textInnerViewer) to[bend left] (innerViewer);

	\node[mytext, anchor=north] (textAccRegionViewer) at (0,{-\R-1.15}) {Область випромінювання\\ (оболонка завтовшки $c\tau$)};
	\draw[->, black!60] (textAccRegionViewer.north west) to[bend left] (accRegion);
\end{tikzpicture}
