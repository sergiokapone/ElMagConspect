\begin{tikzpicture}[
    >=Stealth,
    line width=1.15pt,
    declare function={
    % ===============================================================
    %  КОНСТАНТИ КОНТУРУ C1  (радіус-функція RA)
    % ===============================================================
    RzeroA  = 1.3;                    % середній радіус контуру C1
    aOneA   = 0.55;  phiOneA   = 110; % 1-ша гармоніка: амплітуда й фаза (град.)
    aTwoA   = 0.35;  phiTwoA   = -10; % 2-га гармоніка: амплітуда й фаза (град.)
    aThreeA = 0.22;  phiThreeA = 80;  % 3-тя гармоніка: амплітуда й фаза (град.)
    % ===============================================================
    %  КОНСТАНТИ КОНТУРУ C2  (радіус-функція RB)
    %  Відрізняється від C1 лише aTwoB -- щоб контури не збігалися
    % ===============================================================
    RzeroB  = 1.3;                    % середній радіус контуру C2
    aOneB   = 0.55;  phiOneB   = 110; % 1-ша гармоніка: амплітуда й фаза (град.)
    aTwoB   = 0.435; phiTwoB   = -10; % 2-га гармоніка: амплітуда й фаза (град.)
    aThreeB = 0.22;  phiThreeB = 80;  % 3-тя гармоніка: амплітуда й фаза (град.)
    % ===============================================================
    %  РАДІУС-ФУНКЦІЇ КОНТУРІВ
    %  R(theta) = R0 + a1*cos(t+phi1) + a2*cos(2t+phi2) + a3*cos(3t+phi3)
    % ===============================================================
    RA(\t) = RzeroA
             + aOneA  * cos(\t + phiOneA)
             + aTwoA  * cos(2*\t + phiTwoA)
             + aThreeA* cos(3*\t + phiThreeA);
    RB(\t) = RzeroB
             + aOneB  * cos(\t + phiOneB)
             + aTwoB  * cos(2*\t + phiTwoB)
             + aThreeB* cos(3*\t + phiThreeB);
    % ===============================================================
    %  ГЕОМЕТРІЯ: ЦЕНТРИ Й СТИСКАННЯ КОНТУРІВ
    %  x(t) = cx + sx * R(t) * cos(t)
    %  y(t) = cy + sy * R(t) * sin(t)
    % ===============================================================
    cxA = 0;    cyA = 3.5;   % центр контуру C1 (x, y)
    cxB = 1.0;  cyB = 0.4;   % центр контуру C2 (x, y)
    sxA = 1.05; syA = 0.72;  % масштаб C1 по X та по Y ("перспектива")
    sxB = 1.25; syB = 0.60;  % масштаб C2 по X та по Y
    % ===============================================================
    %  ПОЛОЖЕННЯ ЕЛЕМЕНТІВ dl НА КОНТУРАХ
    %  Частка ДОВЖИНИ дуги: 0 = початок, 1 = повне коло
    %  (аналогічно \tikz mark=at position)
    % ===============================================================
    posDsA = 0.60;   % позиція dl1 на контурі C1
    posDsB = 0.87;   % позиція dl2 на контурі C2
    },
    % ===============================================================
    %  СТИЛІ КРИВИХ
    %  insert path додає шлях до поточного \draw / \path
    % ===============================================================
    curveA/.style={
      insert path={
        plot[variable=\t, domain=0:360, samples=300]
          ({cxA+sxA*RA(\t)*cos(\t)}, {cyA+syA*RA(\t)*sin(\t)})
      }
    },
    curveB/.style={
      insert path={
        plot[variable=\t, domain=0:360, samples=300]
          ({cxB+sxB*RB(\t)*cos(\t)}, {cyB+syB*RB(\t)*sin(\t)})
      }
    },
  ]

  % =====================================================================
  %  ВИДИМИЙ КОНТУР C1 (+ стрілка напрямку обходу)
  % =====================================================================
  \draw[red, curveA, postaction={decorate},
        decoration={markings, mark=at position 0.3 with {
            \node[text=black, above, inner sep=5pt] {$I_1$};
            \arrow{Stealth}
        }}];
  \node[above] at (cxA,cyA+0.25) {$C_1$};

  % =====================================================================
  %  ВИДИМИЙ КОНТУР C2 (+ стрілка напрямку обходу)
  % =====================================================================
  \draw[red, curveB, postaction={decorate},
        decoration={markings, mark=at position 0.68 with {
            \node[text=black, below, inner sep=5pt] {$I_2$};
             \arrow{Stealth}
        }}];
  \node[below] at (cxB,cyB) {$C_2$};

  % =====================================================================
  %  ЕЛЕМЕНТ dl1 на C1 (позиція \posDsA)
  %  Малюється в системі координат, прикріпленій до дотичної:
  %      вісь X збігається з дотичною до кривої,
  %      вісь Y -- з нормаллю.
  % =====================================================================
  \path[curveA, tangent=posDsA] ;
  \begin{scope}[use tangent=1]
    \coordinate (PdsA) at (0,0);
    % вектор dl1 уздовж дотичної
    \draw[->, line width=1.3pt] (0,0) -- (1.1,0);
    % підпис над вектором
    \node at (0.55,+0.55) {$d\vect{l}_1$};
  \end{scope}

  % =====================================================================
  %  ЕЛЕМЕНТ dl2 на C2 (позиція \posDsB)
  % =====================================================================
  \path[curveB, tangent=posDsB];
  \begin{scope}[use tangent=1]
    \coordinate (PdsB) at (0,0);
    % вектор dl2 уздовж дотичної
    \draw[->, line width=1.3pt] (0,0) -- (1.1,0);
    % підпис під вектором
    \node[anchor=north] at (0.55,-0.35) {$d\vect{l}_2$};
  \end{scope}

  % =====================================================================
  %  З'ЄДНУВАЛЬНИЙ ВЕКТОР r21 (від dl2 до dl1)
  % =====================================================================
  \draw[dashed, line width=0.9pt] (PdsB) -- (PdsA);
  \node at ($(PdsA)!0.5!(PdsB)+(0.55,0)$) {$r_{21}$};

\end{tikzpicture}
