\begin{tikzpicture}[rotate=90, scale=1.8]
	\draw[wirecolor, ultra thick] (0, 0) [partial ellipse=0:360:0.6 and 2];
	\draw[arrowpos={0.5}{2pt}{7pt}, wirecolor, ultra thick] (0, 0) [partial ellipse=0:360:0.2 and 0.6];
	\begin{scope}[rotate=-90]
		\fill (0,0) circle (0.7pt);
		\draw[->, thin] (0,0) -- ({2*cos(20)},{0.6*sin(20)}) node[pos=0.6, above] {$R_1$};
		\draw[->, thin] (0,0) -- ({0.6*cos(110)},{0.2*sin(110)}) node[above left, inner sep=1pt] {$R_2$};
		\node at (0,-0.42) {$I$};
	\end{scope}
\end{tikzpicture}
