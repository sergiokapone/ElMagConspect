\begin{tikzpicture}[
    scale=0.75,
    >=latex,
    midarrow/.style={
        postaction={decorate},
        decoration={markings, mark=at position 0.52 with {\arrow{stealth}}}
    }
]
    % === ПАРАМЕТРИ ===
    \def\R{2}          % Радіус соленоїда
    \def\ry{0.4}       % Мала піввісь еліпса (перспектива)
    \def\dy{0.45}      % Крок між витками
    \def\N{10}         % Кількість витків (0..10)
    \def\xL{4}         % Ліва координата X
    \def\yT{9}         % Верхня координата Y

    \pgfmathsetmacro{\xR}{\xL + 2*\R}
    \pgfmathsetmacro{\xC}{\xL + \R}
    \pgfmathsetmacro{\yB}{\yT - \N*\dy}

    % === СИЛОВІ ЛІНІЇ (сині стрілки) ===
    \foreach \x in {4.5, 5.0, ..., 7.5} {
        \draw[->, blue!50, thick] (\x, \yB - 1.5) -- ++(0, 7);
    }

    % === ВИТКИ СОЛЕНОЇДА ===
    % Задня пунктирна дуга верхнього витка
    \draw[dashed, red!50, line width=2] (\xR, \yT) arc (0:180: \R\space and \ry);

    % Передні червоні дуги зі стрілками струму
    \foreach \i in {0,1,...,\N} {
        \pgfmathsetmacro{\y}{\yT - \i*\dy}
        \ifnum\i=\N
            % На останньому витку садимо підпис струму I безпосередньо на шлях
            \draw[red, line width=1, midarrow] (\xL, \y) arc (180:360: \R\space and \ry) node[midway, below] {$I$};
        \else
            \draw[red, line width=1, midarrow] (\xL, \y) arc (180:360: \R\space and \ry);
        \fi
    }

    % === ПЕРЕРІЗ ВИТКІВ ===
    \foreach \i in {0,1,...,\N} {
        \pgfmathsetmacro{\y}{\yT - \i*\dy}
        % Ліва сторона: струм на нас (крапка)
        \draw[thick, fill=white] (\xL, \y) circle [radius=0.2];
        \filldraw[thick] (\xL, \y) circle [radius=0.08];

        % Права сторона: струм від нас (хрестик прямо в ноді шляху)
        \draw[thick, fill=white] (\xR, \y) circle [radius=0.2] node {\tiny $\times$};
    }

    % === РОЗМІРИ ТА ПІДПИСИ НА ШЛЯХАХ ===
    % Радіус R
    \draw[thick] (\xL, \yT) -- ++(0, 0.5)  (\xC, \yT) -- ++(0, 0.5);
    \draw[latex-latex, thick] (\xL, \yT + 0.4) -- node[above] {$R$} (\xC, \yT + 0.4);

    % Довжина l
    \draw[thick] (\xL, \yT) -- ++(-0.5, 0)  (\xL, \yB) -- ++(-0.5, 0);
    \draw[latex-latex, thick] (\xL - 0.45, \yT) -- node[rotate=90, above] {$l$} (\xL - 0.45, \yB);

\end{tikzpicture}