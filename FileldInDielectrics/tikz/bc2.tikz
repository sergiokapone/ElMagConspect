\begin{tikzpicture}[
		>=latex,
		line width=1pt,
	]

	\pgfmathsetmacro\h{0.6}
	\pgfmathsetmacro\l{1.5}
	\coordinate (A) at (-\l, 0);
	\coordinate (B) at (-\l, \h);
	\coordinate (C) at ($(\l, \h) - (0, 1)$);
	\coordinate (D) at ($(\l, 0) - (0, 1)$);

	\coordinate (B') at (-\l, -\h);
	\coordinate (C') at ($(\l, -\h) - (0, 1)$);

	\pic[opacity=0.5] at (0,-0.5) {area};


    \draw[red] (A) -- (B) -- (C) -- (D);

    \draw[dash pattern={on 5pt off 5pt}, red, opacity=0.1] (A) -- (D);
    \draw[->, ultra thick] ($(B)!0.5!(C)$) -- ++(-18:1) node[above] {$d\vect{r}_2$};

    \draw[->, red, ultra thick] (0, -0.5) -- ++(65:3) node[above, inner sep=3pt] {$\Efield_2$};


	\begin{scope}[on background layer]
        \draw[red, dashed, line width=1pt] (D) -- (C') -- (B') -- (A);
        \draw[<-, ultra thick] ($(B')!0.3!(C')$) node[below] {$d\vect{r}_1$} -- ++(-18:1);
        \draw[<-, red, ultra thick] (0, -0.5) -- ++(25:-3) node[above, inner sep=3pt] {$\Efield_1$};
	\end{scope}

\end{tikzpicture}