% Потребує \usetikzlibrary{arrows.meta} у преамбулі (якщо ще не підключено).
% Ілюстрація до оцінки |C12| <= C0: частина силових ліній провідника 1
% замикається на заземленому провіднику 2, решта йде на нескінченність.
\begin{tikzpicture}[>=Stealth, scale=1.05]
	% ---------- Провідники ----------
	\fill[ball color=red!50] (0,0) circle (0.55);
	\node[text=black] at (0,0) {$1$};
	\node[above] at (0,1.7) {$\phi_1=1,\ q_1=C_0$};

	% ---------- силові лінії, "перехоплені" провідником 2 ----------
	\foreach \a/\b in {35/145, 15/165, 0/180, -15/195, -35/215} {
		\draw[midarrow, thick, blue!65!black]
			(0,0) ++(\a:0.55) .. controls +(\a:1.0) and +(\b:1.0) .. (4.3,0) ++(\b:0.55);
	}


	\fill[ball color=red!50] (4.3,0) circle (0.55);
	\node[text=black] at (4.3,0) {$2$};
	\node[above] at (4.3,0.9) {$\phi_2=0,\ q_2=C_{12}$};

	% ---------- символ заземлення ----------
	\draw[thick] (4.3,-0.55) -- (4.3,-0.85);
	\draw[thick] (4.0,-0.85) -- (4.6,-0.85);
	\draw[thick] (4.08,-1.0) -- (4.52,-1.0);
	\draw[thick] (4.16,-1.15) -- (4.44,-1.15);


	% ---------- силові лінії, що йдуть на нескінченність ----------
	\foreach \a in {55,90,125,160,200,235,270,305} {
		\draw[->, thick, red!55!black] (0,0) ++(\a:0.55) -- ++(\a:1.3);
	}

	% ---------- підписи ----------
	\node[blue!65!black, align=center] at (2.15,-2) {\footnotesize перехоплені лінії\\[-2pt]\footnotesize $\rightarrow |q_2|=|C_{12}|$};
	\node[red!55!black] at (-1.7,1.7) {\footnotesize йдуть на $\infty$};
\end{tikzpicture}
