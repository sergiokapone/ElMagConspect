{
  "ltex.language": "uk-UA",
  "ltex.enabled": ["latex"],

  "[latex]": {
    "rewrap.wrappingColumn": 120,
    "editor.wordBasedSuggestions": "off",
    "editor.tabCompletion": "onlySnippets",
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.defaultFormatter": "James-Yu.latex-workshop",
    "editor.wordWrap": "on",
    "editor.rulers": [120]
  },

  "files.associations": {
    "*.tikz": "latex"
  },
  // Автоматизація
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.bind.altKeymap.enabled": false,
  "latex-workshop.latex.clean.fileTypes": ["*.aux", "*.bak*", "*.bbl", "*.blg", "*.bcf", "*.idx", "*.ind", "*.log", "*.lof", "*.lot", "*.out", "*.toc", "*.acn", "*.acr", "*.alg", "*.glg", "*.glo", "*.gls", "*.fls", "*.xml", "*.fdb_latexmk", "*.snm", "*.synctex(busy)", "*.synctex.gz(busy)", "*.synctex.gz", "*.nav", "*.vrb", "*.xdv", "*.run", "*.run.xml"],
  "latex-workshop.latex.magic.args": ["-shell-escape", "-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"],
  "latex-workshop.view.pdf.zoom": "page-width",
  "latex-workshop.view.pdf.viewer": "tab",

  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook",
    "*.copilotmd": "vscode.markdown.preview.editor"
  },

  "latex-workshop.view.pdf.external.synctex.command": "d:/Programs/LaTeX/SumatraPDF/SumatraPDF.exe",
  "latex-workshop.view.pdf.external.synctex.args": ["-forward-search", "%TEX%", "%LINE%", "-reuse-instance", "-inverse-search", "d:\\Programs\\VSCode\\Code.exe -r -g %f:%l", "%PDF%"],

  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": ["-f", "-synctex=1", "-interaction=nonstopmode", "%DOC%"]
    },
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%DOCFILE%"]
    },
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": ["-shell-escape", "-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": ["%DOCFILE%"]
    },
    {
      "name": "upmendex",
      "command": "upmendex",
      "args": ["%DOCFILE%"]
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": ["latexmk"]
    },
    {
      "name": "[User] pdflatex -> bibtex -> pdflatex*2",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    },
    {
      "name": "[User] latexmk -> bibtex -> xelatex*2",
      "tools": ["latexmk", "bibtex", "xelatex", "xelatex"]
    },
    {
      "name": "[User] PDFLaTeX",
      "tools": ["pdflatex"]
    },
    {
      "name": "[User] LuaLaTeX -> biber -> upmendex -> LuaLaTeX*2",
      "tools": ["lualatex", "biber", "upmendex", "lualatex", "lualatex"]
    },
    {
      "name": "[User] LuaLaTeX -> biber -> LuaLaTeX",
      "tools": ["lualatex", "biber", "lualatex"]
    },
    {
      "name": "[User] LuaLaTeX",
      "tools": ["lualatex"]
    },
    {
      "name": "[User] XeLaTeX",
      "tools": ["xelatex"]
    },
    {
      "name": "[User] BibTeX",
      "tools": ["bibtex"]
    },
    {
      "name": "[User] Biber",
      "tools": ["biber"]
    },
    {
      "name": "[User] xelatex -> bibtex -> xelatex*2",
      "tools": ["xelatex", "bibtex", "xelatex", "xelatex"]
    },
    {
      "name": "[User] bibtex -> xelatex",
      "tools": ["bibtex", "xelatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk",
  "latex-workshop.message.log.show": false,
  "latex-workshop.message.badbox.show": "both",
  "latex-workshop.message.warning.show": false,
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.linting.chktex.enabled": true,
  "latex-workshop.linting.run": "onSave",
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.hover.preview.enabled": true,
  "latex-workshop.hover.citation.enabled": true,
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "latex-workshop.linting.chktex.exec.args": ["-wall", "-n19", "-n22", "-n30", "-q"],
   // tssworkflow
  "tssworkflow.normalizeLineBreaks": "wrap",
  "tssworkflow.blankLinesParagraph": 1,
  "tssworkflow.blankLinesHeading": 2,
  "tssworkflow.normalizeFrames": true,
  "tssworkflow.normalizeTables": false,
  "tssworkflow.normalizeTypography": true,
  "tssworkflow.displayMathToEquation": true,
  "tssworkflow.normalizeBlankLines": true,
  "tssworkflow.quoteStyle": "enquote",
  "tssworkflow.externalViewerCommand": "d:/Programs/LaTeX/SumatraPDF/SumatraPDF.exe",
  "tssworkflow.logParser": "texlogsieve",
  "tssworkflow.frameRules": {
    "section":  "%% ========================================================",
    "subsection":   "% ---------------------------------------------------------",
    "equation":     "% .........................................................",
  },
  "tssworkflow.jobname": "main",
  "tssworkflow.driver": "alone.tex",
  "tssworkflow.pdfBeside": true,
  "tssworkflow.forceRebuild": true,
  // ---------------------------
  "files.exclude": {
    // --- Файлы ---
    "**/desktop.ini": true,
    "**/google*.html": true,
    "**/descript.ion": true,
    "**/*.bak*": true,
    "**/*.out": true,
    "**/*.aux": true,
    "**/*.log": true,
    "**/*.gz": true,
    "**/*.bbl": true,
    "**/*.blg": true,
    "**/*.bcf": true,
    "**/*.toc": true,
    "**/*.idx": true,
    "**/*.ind": true,
    "**/*.ilg": true,
    "**/*.nlg": true,
    "**/*.nlo": true,
    "**/*.nls": true,
    "**/*.snm": true,
    "**/*.nav": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.run.xml": true,
    "**/*.table": true,
    "**/*.gnuplot": true,
    "**/*.thm": true,
    "**/*.bbl-*": true,
    "**/*.bcf-*": true,
    // --- Папки ---
    "**/.archive": true,
    "**/build": true,
    "**/out": true,
    "**/.vscode": false,
    "**/__pycache__": true
  },

  "latex-workshop.hover.preview.newcommand.newcommandFile": "mathjax-macros.tex",
  "latex-workshop.hover.preview.mathjax.extensions": ["boldsymbol"]
}
