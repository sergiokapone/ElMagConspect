\begin{tikzpicture}[
		>=latex,
		line width=1pt,
		vertical ticks/.style={
				decoration={markings,
						mark=between positions 0 and 1 step 0.05 with {
								\pgftransformresetnontranslations
								\draw[] (0 ,0) -- ++(0, -0.3);
							}
					},
				postaction={decorate}
			},
		area/.pic={
				\node [] (0) at (-4, 0) {};
				\node [] (1) at (0, -2.5) {};
				\node [] (2) at (4, 0) {};
				\node [] (3) at (0, 2) {};
				\draw [in=165, out=90, looseness=0.75, name path=A] (0.center) to (3.center);
				\draw [in=90, out=-15, name path=C] (3.center) to (2.center);
				\draw [vertical ticks, in=-30, out=-90, looseness=0.75, name path=D] (2.center) to (1.center);
				\draw [vertical ticks, in=-90, out=135, looseness=1.25, name path=B] (1.center) to (0.center);
				\tikzfillbetween[of=A and B]{red!20};
				\tikzfillbetween[of=C and D]{red!20};
			}
	]




	\pgfmathsetmacro\h{1.3}
	\pgfmathsetmacro\R{1}
	\pgfmathsetmacro\r{0.4}

	\coordinate (A) at (-\R, 0);
	\coordinate (B) at (-\R, \h);
	\coordinate (C) at (\R, \h);
	\coordinate (D) at (\R, 0);

	\coordinate (B') at (-\R, -\h);
	\coordinate (C') at (\R, -\h);

	\pic[opacity=0.5] (0,0) {area};

	\draw[dashed, red] (A) arc(180:0:{\R} and \r);
	\draw[red] (A) -- (B) arc(180:0:{\R} and \r) -- (D) arc(0:-180:{\R} and \r) -- cycle;
	\draw[red] (B) arc(180:360:{\R} and \r);
	\fill[fill=red, opacity=0.5, pattern=north east lines, pattern color=red, line width=0.5mm] (0, 0) circle({\R} and \r);

	\draw[->] ($(B)!0.5!(C)$) -- ++(0, 1) node[above] {$d\vect{S}_2$};

	\draw[->] (0, 0) -- ++(0, 0.75) node[left, inner sep=3pt] {$\vect{n}$};

    \draw[->, red, ultra thick] (0, 0) -- ++(65:3) node[above, inner sep=3pt] {$\Efield_2$};
%	\draw[->] (+0.25, 0) -- ++(0, 0.75) node[anchor=north west, inner sep=3pt] {$\vect{n}_1$};


	\begin{scope}[opacity=0.5]
%		\draw[->] (0, 0) -- ++(0, -0.75) node[anchor=west, inner sep=3pt] {$\vect{n}_2$};
        \draw[->, line width=1pt] ($(B')!0.5!(C')$) -- ++(0, -1) node[right] {$d\vect{S}_1$};
		\draw[dashed, red, line width=1pt] (A) -- (B') arc(180:360:{\R} and \r) -- (D);
		\draw[dashed, red, line width=1pt] (B') arc(180:0:{\R} and \r);
        \draw[<-, red, ultra thick] (0, 0) -- ++(25:-3) node[above, inner sep=3pt] {$\Efield_1$};
	\end{scope}

\end{tikzpicture}