% поле і потенціал рівномірно зарядженої кулі (безрозмірні: r/R, E R^2/Q, phi R/Q)
\begin{tikzpicture}[>=latex, font=\small, x=1.7cm, y=1.7cm]
	\fill[gray!15] (0,0) rectangle (1,1.75);
	\node[gray] at (0.5,1.65) {куля};
	\draw[->] (0,0) -- (3.4,0) node[right] {$r/R$};
	\draw[->] (0,0) -- (0,1.85);
	\foreach \x in {1,2,3} \draw (\x,0.04) -- (\x,-0.04) node[below] {$\x$};
	\foreach \y/\l in {1/1, 1.5/{3/2}} \draw (0.04,\y) -- (-0.04,\y) node[left] {$\l$};
	\draw[dashed, gray] (1,0) -- (1,1.75);
	% потенціал: (3 - x^2)/2 усередині, 1/x зовні
	\draw[thick, blue, domain=0:1, samples=30] plot (\x, {(3-\x*\x)/2});
	\draw[thick, blue, domain=1:3.2, samples=40] plot (\x, {1/\x});
	\node[blue, above right] at (3.2,{1/3.2}) {$\phi R/Q$};
	% поле: x усередині, 1/x^2 зовні
	\draw[thick, red, domain=0:1] plot (\x, \x);
	\draw[thick, red, domain=1:3.2, samples=40] plot (\x, {1/(\x*\x)});
	\node[red] at (1.75,0.11) {$ER^2/Q$};
\end{tikzpicture}
