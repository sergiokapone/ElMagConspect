% гауссові поверхні для площини, нитки та сферичної оболонки
\begin{tikzpicture}[>=latex, font=\small]
	% --- площина (видно з торця) і циліндр, що її перетинає
	\begin{scope}
		\fill[red!15] (-0.12,-1.6) rectangle (0.12,1.6);
		\draw[red, thick] (0,-1.6) -- (0,1.6);
		\node[red, above] at (0,1.6) {$\sigma$};
		\draw[blue, dashed] (-1,-0.6) rectangle (1,0.6);
		\draw[blue, dashed] (-1,0) ellipse (0.15 and 0.6);
		\draw[blue, dashed] (1,0) ellipse (0.15 and 0.6);
		\foreach \y in {-1.2,-0.3,0.3,1.2} {
				\draw[->, red!70!black] (0.15,\y) -- (1.7,\y);
				\draw[->, red!70!black] (-0.15,\y) -- (-1.7,\y);
			}
		\node[blue, below] at (1,-0.6) {$S$};
		\node at (0,-2.1) {а)};
	\end{scope}
	% --- нитка і коаксіальний циліндр
	\begin{scope}[xshift=4.0cm]
		\draw[red, very thick] (0,-1.6) -- (0,1.6);
		\node[red, above] at (0,1.6) {$\lambda$};
		\draw[blue, dashed] (0,0.8) ellipse (0.9 and 0.25);
		\draw[blue, dashed] (0,-0.8) ellipse (0.9 and 0.25);
		\draw[blue, dashed] (-0.9,-0.8) -- (-0.9,0.8) (0.9,-0.8) -- (0.9,0.8);
		\foreach \y in {-0.4,0.4} {
				\draw[->, red!70!black] (0.05,\y) -- (1.6,\y);
				\draw[->, red!70!black] (-0.05,\y) -- (-1.6,\y);
			}
		\draw[<->] (0,-1.3) -- node[below] {$r$} (0.9,-1.3);
		\node[blue] at (1.2,1.15) {$h$};
		\node at (0,-2.1) {б)};
	\end{scope}
	% --- сферична оболонка і концентрична сфера
	\begin{scope}[xshift=8.0cm]
		\draw[red, thick, fill=red!8] (0,0) circle (0.8);
		\node[red] at (0,0.45) {$Q$};
		\draw[blue, dashed] (0,0) circle (1.3);
		\foreach \a in {0,45,...,315}
			\draw[->, red!70!black] (\a:0.85) -- (\a:1.75);
		\draw[->] (0,0) -- node[pos=0.55, below] {$r$} (-35:1.3);
		\fill (0,0) circle (1pt);
		\node at (0,-2.1) {в)};
	\end{scope}
\end{tikzpicture}
