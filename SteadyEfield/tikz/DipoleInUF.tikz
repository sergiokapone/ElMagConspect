\begin{tikzpicture}[>=latex]
	\foreach \i in {-1,-0.5,...,1} {
			\draw[->, red] (-3, \i) -- ++(6, 0);
		}

	\node [circle, ball color=blue, inner sep=1.2pt, text=white]
	(qn) at (-1,-0.75) {\tikz\draw[thick] (0,0) -- ++(0.2,0);};

	\node [circle, ball color=red, inner sep=0pt, text=white,
		font=\scriptsize] (qp) at (1,0.75) {$+$};


    	\draw[->, ultra thick, red] (qn) -- ++(-1, 0) node[left]
	{$-q\Efield$};

	\draw[->, ultra thick, red] (qp) -- ++(1, 0) node[right]
	{$+q\Efield$};

	\node[inner sep=1pt, circle, fill] (O) at (0, -1.5) {};
	\node[below] at (O) {$O$};

	\draw[->, ultra thick, cyan] (O) -- node[left] {$\vect{r}_-$}(qn);
	\draw[->, ultra thick, cyan] (O) -- node[right] {$\vec{r}_+$}(qp);

	\draw[->, gray, ultra thick] (qn) -- node[above] {$\vect{\ell}$} (qp);
\end{tikzpicture}