% Скін-ефект: густина струму в перерізі мідного дроту діаметром 0,5 мм.
% Розподіл |j(r)| = |J0(kr)|/|J0(kR)|, k=(1-i)/delta, обчислено заздалегідь (колір ~ |j|).
\begin{tikzpicture}[scale=1]
	\colorlet{skinlow}{gray!8}
	\def\r{1}
	\def\vx{0.55}\def\vy{0.42}       % зсув задньої основи (косокутна проєкція)
	\def\tx{0.607}\def\ty{0.795}     % точки дотику твірних (перпендикулярно до зсуву)
	% бічна поверхня: одна замкнена фігура між твірними (видно лише частину за торцем),
	% тінь поперек осі циліндра; задня основа невидима, тож її не малюємо
	\newcommand{\skinside}{%
		\begin{scope}
			\clip (-\tx, \ty) -- ++(\vx, \vy) arc[start angle=127.4, end angle=-52.6, radius=\r] -- (\tx, -\ty) arc[start angle=-52.6, end angle=127.4, radius=\r] -- cycle;
			\shade[top color=gray!30, middle color=gray!8, bottom color=gray!62, shading angle=37.4] (-1.3, -1.3) rectangle (1.9, 1.75);
		\end{scope}
		\draw[wirecolor!50, thin] (-\tx, \ty) -- ++(\vx, \vy) arc[start angle=127.4, end angle=-52.6, radius=\r] -- (\tx, -\ty);
	}
	% f = 50 Гц: delta = 9348.0 мкм
