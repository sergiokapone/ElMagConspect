% Радіальне стікання заряду з кулі: у кожній точці j і j_зм рівні й протилежні
\begin{tikzpicture}[>=latex, scale=1.6]
	\def\T{18}
	% сфера S радіуса r>R (на неї натягнуто контур L)
	\draw[gray!60, dashed] (0, 0) circle (1.25);
	\draw[gray!60, dashed] (0, 0) ellipse ({1.25} and {1.25*sin(\T)});
	\node[gray!60!black, font=\footnotesize] at (128:1.4) {$S$};
	% заряджена куля
	\shade[ball color=gray!35] (0, 0) circle (0.42);
	\node[font=\footnotesize\bfseries] at (0, 0) {$+Q$};
	% пари векторів у тих самих точках: j назовні, j_зм усередину
	\foreach \a in {0, 36, ..., 324} {
		\draw[jfield, thick, ->] ($(\a:0.6)+(\a+90:0.055)$) -- ($(\a:1.12)+(\a+90:0.055)$);
		\draw[efield, thick, ->, dash pattern=on 2.5pt off 1.2pt] ($(\a:1.12)+(\a-90:0.055)$) -- ($(\a:0.6)+(\a-90:0.055)$);
	}
	\node[jfield, anchor=south west, inner sep=1pt] at (36:1.12) {$\vect j$};
	\node[efield, anchor=north west, inner sep=1pt] at (0:1.08) {$\vect j_\text{зм}$};
\end{tikzpicture}
