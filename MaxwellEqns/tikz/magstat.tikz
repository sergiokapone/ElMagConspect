% Магнітостатика: поле прямого провідника зі струмом (об'ємний вигляд)
\begin{tikzpicture}[>=latex, scale=0.8]
	\def\Ht{3.4}      % півдовжина дроту
	\def\rw{0.2}      % радіус дроту
	\def\ryw{0.07}
	% три "поверхи" кіл: знизу, посередині, зверху
	\def\Zs{-1.6/0, 0/0, 1.6/0}
	% задня половина магнітних ліній
	\foreach \z/\dummy in \Zs {
		\foreach \a in {0.7, 1.1, 1.5} {
			\draw[bfield!45, dash pattern=on 2pt off 0.8pt] (\a, \z) arc[start angle=0, end angle=180, x radius=\a, y radius={0.32*\a}];
		}
	}
	% дріт: циліндр з градієнтом
	\shade[left color=gray!55, right color=gray!15] (-\rw, \Ht) -- (-\rw, -\Ht) arc[start angle=180, end angle=270, x radius=\rw, y radius=\ryw] -- (0, \Ht) -- cycle;
	\shade[left color=gray!15, right color=gray!78] (0, \Ht) -- (0, -\Ht-\ryw) arc[start angle=270, end angle=360, x radius=\rw, y radius=\ryw] -- (\rw, \Ht) -- cycle;
	\draw[wirecolor, thin] (-\rw, \Ht) -- (-\rw, -\Ht) arc[start angle=180, end angle=360, x radius=\rw, y radius=\ryw] -- (\rw, \Ht);
	\shade[ball color=gray!25] (0, \Ht) ellipse ({\rw} and {\ryw});
	\draw[wirecolor, thin] (0, \Ht) ellipse ({\rw} and {\ryw});
	% напрямок струму
	\draw[->, jfield, ultra thick] (0, -2.9) -- (0, -1.9) node[right, pos=0.5, text=black] {$I$};
	% передня половина магнітних ліній (стрілки)
	\foreach \z/\dummy in \Zs {
		\foreach \a in {0.7, 1.1, 1.5} {
			\draw[bfield, thin, arrowpos={0.5}{2pt}{3pt}] (\a, \z) arc[start angle=0, end angle=-180, x radius=\a, y radius={0.32*\a}];
		}
	}
	\node[bfield, font=\small] at (1.9, 0.25) {$\Bfield$};
\end{tikzpicture}