% Магнітостатика: поле прямого провідника зі струмом (об'ємний вигляд)
\begin{tikzpicture}[>=latex, scale=0.8]
	\def\Ht{3.4}      % півдовжина дроту
	\def\rw{0.2}      % радіус дроту
	\def\ryw{0.07}
	% задня половина магнітних ліній (за дротом)
	\foreach \z/\a in {-1.2/0.8, 0.2/1.2, 1.6/1.7} {
		\draw[bfield!45, dash pattern=on 2pt off 0.8pt] (\a, \z) arc[start angle=0, end angle=180, x radius=\a, y radius={0.3*\a}];
	}
	% дріт: циліндр з градієнтом
	\shade[left color=gray!55, right color=gray!15] (-\rw, -\Ht) rectangle (0, \Ht);
	\shade[left color=gray!15, right color=gray!78] (0, -\Ht) rectangle (\rw, \Ht);
	\shade[ball color=gray!25] (0, \Ht) ellipse ({\rw} and {\ryw});
	\draw[wirecolor, thin] (0, \Ht) ellipse ({\rw} and {\ryw});
	% напрямок струму
	\draw[->, jfield, ultra thick] (0, -2.9) -- (0, -1.9) node[right, pos=0.5, text=black] {$I$};
	% передня половина магнітних ліній (стрілки)
	\foreach \z/\a in {-1.2/0.8, 0.2/1.2, 1.6/1.7} {
		\draw[bfield, thin, arrowpos={0.5}{2pt}{3pt}] (\a, \z) arc[start angle=0, end angle=-180, x radius=\a, y radius={0.3*\a}];
	}
	\node[bfield, font=\small] at (1.9, 0.25) {$\Bfield$};
\end{tikzpicture}
