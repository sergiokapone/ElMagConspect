% Оцінка товщини скін-шару: переріз дроту (струм на нас), контур l x delta біля поверхні
\begin{tikzpicture}[>=latex, scale=1.5]
	% переріз: скін-шар темніший за серцевину
	\fill[jfield!18] (0,0) circle (1.5);
	\fill[gray!8] (0,0) circle (1.0);
	\draw (0,0) circle (1.5);
	\draw[gray, dashed] (0,0) circle (1.0);
	% струм j (на нас) -- лише у шарі
	\foreach \a in {15,45,...,345} {
		\draw[jfield] (\a:1.25) circle (0.05);
		\fill[jfield] (\a:1.25) circle (0.022);
	}
	\node[jfield, font=\scriptsize] at (90:1.25) [right=3pt] {$\vect j$};
	% H поза дротом -- коло, проти год. стрілки
	\draw[bfield, thin, postaction={decorate, decoration={markings, mark=at position 0.375 with {\arrow{Latex}}}}]
		(0,0) circle (1.8);
	\node[bfield, font=\scriptsize] at (135:1.95) {$\Hfield$};
	% H у шарі: дотичне до поверхні, спадає вглиб
	\foreach \x in {0.03, 0.12, ..., 0.5} {
		\pgfmathsetmacro{\L}{0.7*exp(-\x/0.22)}
		\draw[->, bfield] ({\x-1.5}, {\L/2}) -- ++(0, -\L);
	}
	% контур інтегрування
	\draw[wirecolor, thick,
		arrowpos={0.15}{2pt}{4pt}, arrowpos={0.4}{2pt}{4pt},
		arrowpos={0.65}{2pt}{4pt}, arrowpos={0.9}{2pt}{4pt}]
		(-1.5, 0.3) -- ++(0, -0.6) -- ++(0.5, 0) -- ++(0, 0.6) -- cycle;
	\node[left, font=\scriptsize] at (-1.5, 0) {$\ell$};
	\node[below, font=\scriptsize] at (-1.25, -0.3) {$\delta$};
\end{tikzpicture}
