% Дві різні поверхні, натягнуті на один контур (об'ємний вигляд).
% Порядок малювання задає видимість: що далі від глядача, те раніше.
\tikzset{
	cyl/.style={line width=3.2pt, wirecolor!70, line cap=round},
	cylhl/.style={line width=1.1pt, white, opacity=0.55, line cap=round},
	surf/.style={fill=bfield!45, fill opacity=0.7},
}
% провід від y=#1 до y=#2 (з відблиском)
\newcommand{\tscwire}[2]{%
	\draw[cyl] (0, #1) -- (0, #2);
	\draw[cylhl] (-0.03, #1) -- (-0.03, #2);
}
% обкладка радіуса 1 завтовшки 0.14 з нижньою основою на висоті #1
\newcommand{\tscplate}[1]{%
	\shade[left color=gray!30, right color=gray!70] (-1, #1) -- ++(0, 0.14) arc[start angle=180, end angle=360, x radius=1, y radius=0.3] -- ++(0, -0.14) arc[start angle=360, end angle=180, x radius=1, y radius=0.3];
	\fill[gray!18] (0, #1+0.14) ellipse (1 and 0.3);
	\draw[gray!60!black, thin] (0, #1+0.14) ellipse (1 and 0.3);
}
% обкладки: нижня (+) на y=0, верхня (-) на y=1.6
\def\tscgap{1.6}
% зовнішнє коло, струм і знаки зарядів (позаду всього)
\newcommand{\tscback}{%
	\draw[wirecolor!70, line width=3.2pt, line cap=round] (0, 3.3) to[out=10, in=-10, looseness=1.6] (0, -2.9);
	\draw[jfield, ->, very thick] (-0.5, -2.75) -- ++(0, 0.6) node[left, pos=0.5, text=black] {$I$};
	\node[font=\small\bfseries] at (1.75, 0.07) {$+$};
	\node[font=\small\bfseries] at (1.75, \tscgap+0.07) {$-$};
}
\begin{minipage}[t]{0.48\linewidth}\centering
	\begin{tikzpicture}[scale=0.75, >=latex]
		\tscback
		% провід під площею S: його верхній кінець видно крізь площу
		\tscwire{-2.9}{-1.5}
		% площа S, натягнута на контур L
		% (напівпрозора, тож видно частину проводу під нею)
		\fill[surf, fill opacity=0.5] (0, -1.5) ellipse (1.4 and 0.55);
		\draw[wirecolor, thick, arrowpos={0.75}{3pt}{4pt}] (0, -1.5) ellipse (1.4 and 0.55);
		% частина проводу під площею, що просвічує крізь неї
		\draw[wirecolor!80!black, line width=3.2pt, opacity=0.35] (0, -1.5) -- (0, -2.05);
		% "отвір", де провід протикає S
		\fill[black!80] (0, -1.5) ellipse (0.11 and 0.045);
		% \draw[jfield, thick] (0, -1.5) ellipse (0.22 and 0.09);
		% провід над площею S
		\tscwire{-1.5}{0}
		\tscplate{0}
		\tscplate{\tscgap}
		\tscwire{\tscgap+0.14}{3.3}
		\node[wirecolor, font=\small] at (-1.85, -1.5) {$L$};
		\node[bfield!80!black, font=\small] at (1.75, -0.9) {$S$};
		\draw[bfield!80!black, thin] (1.6, -1.0) -- (0.9, -1.4);
		% \node[jfield, font=\scriptsize, align=right, anchor=east] at (-0.3, -0.75) {провід\\[-2pt]протикає $S$};
		% \draw[jfield, thin, ->] (-0.35, -0.95) -- (-0.12, -1.42);
	\end{tikzpicture}\par\smallskip
	\footnotesize Площа $S$ пронизується лише струмом провідності
\end{minipage}\hfill
\begin{minipage}[t]{0.48\linewidth}\centering
	\begin{tikzpicture}[scale=0.75, >=latex]
		\def\yb{0.8} % дно "мішка" -- посередині між обкладками
		\tscback
		\tscwire{-2.9}{0}
		\tscplate{0}
		% нижні частини стрілок струму зміщення (усередині "мішка")
		\foreach \x in {-0.5, 0, 0.5}
			\draw[efield, thick] (\x, 0.2) -- (\x, \yb);
		% поверхня S: "мішок" із краєм L, дно якого проходить між обкладками
		\fill[surf, fill opacity=0.45] (-1.4, -1.5) -- (-1.4, \yb) arc[start angle=180, end angle=0, x radius=1.4, y radius=0.42]
			-- (1.4, -1.5) arc[start angle=0, end angle=-180, x radius=1.4, y radius=0.55] -- cycle;
		\fill[surf] (0, \yb) ellipse (1.4 and 0.42);
		\draw[bfield!70!black, thin] (-1.4, -1.5) -- (-1.4, \yb) (1.4, -1.5) -- (1.4, \yb);
		\draw[bfield!70!black] (0, \yb) ellipse (1.4 and 0.42);
		\draw[wirecolor, thick, arrowpos={0.75}{3pt}{4pt}] (0, -1.5) ellipse (1.4 and 0.55);
		% верхні частини стрілок (над дном мішка)
		\foreach \x in {-0.5, 0, 0.5}
			\draw[efield, ->, thick] (\x, \yb) -- (\x, \tscgap-0.05);
		\tscplate{\tscgap}
		\tscwire{\tscgap+0.14}{3.3}
		\node[efield, font=\footnotesize, anchor=east] at (-1.1, 1.75) {$\parttime\Dfield$};
		\draw[efield, thin] (-1.15, 1.6) -- (-0.55, 1.25);
		\node[wirecolor, font=\small] at (-1.85, -1.5) {$L$};
		\node[bfield!80!black, font=\small] at (1.6, -0.9) {$S$};
		% \node[bfield!80!black, font=\scriptsize, align=left, anchor=west] at (1.5, \yb+0.15) {дно $S$};
	\end{tikzpicture}\par\smallskip
	\footnotesize Площа $S$ пронизується лише струмом зміщення
\end{minipage}
