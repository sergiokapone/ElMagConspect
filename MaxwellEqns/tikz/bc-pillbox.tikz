% Циліндр Гаусса на межі розділу двох середовищ (об'ємний вигляд)
\begin{tikzpicture}[>=latex, line width=0.8pt, font=\small]
	\def\rx{1.4}\def\ry{0.42}\def\yc{0.1}\def\hh{0.85}
	\pgfmathsetmacro\yt{\yc+\hh}
	\pgfmathsetmacro\yb{\yc-\hh}
	% середовище 1 (внизу) і 2 (вгорі)
	\node[anchor=west, align=left, text=gray!60!black] at (-5.9, 1.55) {середовище $2$\\ $\epsilon_2$, $\mu_2$};
	\node[anchor=west, align=left, text=gray!60!black] at (-5.9, -1.55) {середовище $1$\\ $\epsilon_1$, $\mu_1$};
	% межа розділу: площина з перспективою
	\path[fill=gray!14, draw=gray!55] (-3.6, -0.45) -- (2.4, -0.45) -- (3.9, 0.7) -- (-2.1, 0.7) -- cycle;
	\node[anchor=east, font=\footnotesize, text=gray!60!black] at (-3.7, 0.0) {межа розділу};
	% вільні заряди на межі
	\foreach \p in {(-2.5,-0.05),(-1.9,0.4),(-0.4,0.55),(1.8,0.45),(2.6,0.1),(-0.3,-0.3),(1.3,-0.25),(0.7,0.55)}
		\node[efield, font=\scriptsize\bfseries] at \p {$+$};
	\node[efield, font=\footnotesize] at (3.1, 0.62) {$\sigma$};
	% задня половина нижньої основи (штрихом)
	\draw[dashed, efield!70] (-\rx, \yb) arc[start angle=180, end angle=0, x radius=\rx, y radius=\ry];
	% напівпрозоре тіло циліндра
	\shade[left color=efield!8, right color=efield!38, opacity=0.75] (-\rx, \yb) -- (-\rx, \yt) arc[start angle=180, end angle=360, x radius=\rx, y radius=\ry] -- (\rx, \yb) arc[start angle=360, end angle=180, x radius=\rx, y radius=\ry] -- cycle;
	% переріз по межі
	\fill[efield!40, opacity=0.55] (0, \yc) ellipse ({\rx} and {\ry});
	\draw[efield!70, dotted] (0, \yc) ellipse ({\rx} and {\ry});
	% верхня основа
	\fill[efield!10] (0, \yt) ellipse ({\rx} and {\ry});
	\draw[efield] (0, \yt) ellipse ({\rx} and {\ry});
	\draw[efield] (-\rx, \yb) -- (-\rx, \yt) (\rx, \yb) -- (\rx, \yt);
	\draw[efield] (-\rx, \yb) arc[start angle=180, end angle=360, x radius=\rx, y radius=\ry];
	% вектори: нормаль, елементи поверхні, поле
	\draw[->, ultra thick] (0, \yc) -- (0, \yt+1.2) node[above] {$\vect n$};
	\draw[->, thick] (-0.85, \yt+0.02) -- ++(0, 0.75) node[left, pos=0.7] {$d\vect S_2$};
	\draw[->, thick] (-0.85, \yb-0.02) -- ++(0, -0.75) node[left, pos=0.7] {$d\vect S_1$};
	\draw[->, ultra thick, efield] (0.35, \yt+0.15) -- ++(15:2.0) node[above right, inner sep=2pt] {$\Dfield_2$};
	\draw[->, ultra thick, efield] (0.35, \yb-0.95) -- ++(15:2.0) node[above right, inner sep=2pt] {$\Dfield_1$};
\end{tikzpicture}
