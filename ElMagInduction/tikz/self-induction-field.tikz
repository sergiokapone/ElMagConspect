% Адаптовано з ElMagInduction.tex (слайд "Явище самоіндукції")
\begin{tikzpicture}[rotate=90, scale=1.25, >=latex, midarrow/.style={%
				postaction={ decorate,
						decoration={ markings, mark=at position .7 with {\arrow{latex}}}}}]
	\begin{scope}
		\draw[arrowpos={0.5}{2pt}{7pt}, red!40, ultra thick] (1.1,0) [partial ellipse=0:360:0.3 and 1]
		node[pos=0.5, below] {$I$};
	\end{scope}
	\foreach \y in {-3,...,3}{
			\draw[blue, midarrow] plot[domain=1:3] (\x, 0.2*\y+0.05*\y*\x^2);
		}
\end{tikzpicture}
