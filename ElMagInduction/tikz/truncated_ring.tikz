\begin{tikzpicture}[
    >=Stealth,
    line cap=round,
    line join=round,
    wire/.style={draw=wirecolor, line width=1.2pt},
    vortex/.style={draw=efield, line width=0.9pt, postaction={decorate,
        decoration={markings, mark=between positions 0.12 and 0.95 step 0.25 with {\arrow{Stealth}}}}},
    charge field/.style={->, draw=efield, dashed, line width=0.8pt}
]
    \def\R{2}
    \def\d{8.6}   % половина розміру розрізу, градуси

    % Область магнітного поля (на нас), поле зростає
    \fill[bfield!10] (0,0) circle (1.0);
    \draw[bfield!30, thin] (0,0) circle (1.0);
    \foreach \r in {0.3,0.7} \foreach \a in {0,60,...,300}
        {\fill[bfield] (\a+\r*40:\r) circle (1.2pt);}
    \node[bfield, font=\small] at (0,0) {$\Bfield$};

    % Вихрове електричне поле: замкнені лінії (за годинниковою стрілкою)
    \draw[vortex] (90:1.5) arc (90:-270:1.5);
    \node[efield, font=\small] at (135:1.5) [above left=-1pt] {$\Efield$};

    % Кільце з розрізом справа
    \draw[wire] (\d:\R) arc (\d:360-\d:\R);

    % Вимірювальні проводи від країв розрізу до вольтметра
    \draw[wire] (1.976,0.3) -- (3.48,0.3);
    \draw[wire] (1.976,-0.3) -- (3.48,-0.3);

    % Вольтметр
    \draw[wire] (4,0) circle (0.6);
    \node at (4,0) {$V$};

    % Заряди на краях розрізу
    \foreach \a in {16,24,32}{
        \node[efield!80!black, font=\scriptsize\bfseries] at (\a:\R+0.0) {$+$};
        \node[efield!80!black, font=\scriptsize\bfseries] at (-\a:\R+0.0) {$-$};
    }

    % Поле цих зарядів у розриві (між проводами вольтметра)
    \foreach \x in {2.3,2.75,3.2}
        \draw[charge field] (\x,0.22) -- (\x,-0.22);
\end{tikzpicture}
