\begin{tikzpicture}[>=Latex, scale=1.2, every node/.style={font=\small}]
	% зовнішнє однорідне поле
	\foreach \y in {-1.6, -1.1, ...,1.6}{
		\draw[red!25, thick, -{Latex[length=2mm]}] (-2.5,\y) -- (2.5,\y);
	}
	\node[red!55] at (2.7,1.6) {$\Hfield_0$};

	% провідник
	\fill[gray!70] (0,0) circle (0.18);
	\node[below] at (0,-0.25) {$I$};

	% власне поле струму -- концентричні кола
	\foreach \r in {0.5, 0.9, 1.3}{
		\draw[blue!50, thick, -{Latex[length=2mm]}] (0,0) circle (\r);
	}

	% підсумкові лінії: згущення / розрідження
	\draw[green!50!black, ultra thick, -{Latex[length=3mm]}] (1.0,0) -- (2.2,0) node[right] {згущення};
	\draw[orange!85!black, ultra thick, -{Latex[length=3mm]}] (-2.2,0) -- (-1.0,0) node[left] {розрідження};
\end{tikzpicture}