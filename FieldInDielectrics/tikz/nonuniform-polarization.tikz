\begin{tikzpicture}[>=latex]
	\pgfmathsetseed{1}
	\draw[fill=gray!5, line width=1pt, draw=gray!40] (0, 0) circle (2);
	\foreach \a in {10,20,...,360} {
			\draw[thick, ->, brown] (\a:{0.2 + 0.1*rnd}) -- (\a:1.8);
			\node[text=red]  at (\a:2) {$+$};
			\node[text=blue] at (\a:1) {$-$};
		}
	\node at (-1.4,-1.4) {$V$};
	\draw[->] (2.3,0.6) -- ++(0.9,0.4) node[right] {$dS$};
\end{tikzpicture}
