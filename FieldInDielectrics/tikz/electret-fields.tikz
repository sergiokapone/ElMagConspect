% Поля електрета; побудовано так само, як поля постійного магніту (MagFieldMedia/tikz/magnet-fields.tikz):
% (а) індукція D --- лінії замкнені; (б) напруженість E --- лінії від + до −, всередині проти P.
\tikzset{
	electretbody/.pic={
			\fill[gray!20] (-0.75,1) -- (-0.75,-1) arc[start angle=180,end angle=360,x radius=0.75,y radius=0.19] -- (0.75,1) -- cycle;
			\fill[red!25] (0,1) ellipse [x radius=0.75,y radius=0.19];
			\draw[thick] (-0.75,1) -- (-0.75,-1) arc[start angle=180,end angle=360,x radius=0.75,y radius=0.19] -- (0.75,1);
			\draw[thick] (0,1) ellipse [x radius=0.75,y radius=0.19];
			\draw[dashed] (-0.75,-1) arc[start angle=180,end angle=0,x radius=0.75,y radius=0.19];
			\node[text=red, font=\scriptsize, inner sep=0pt] at (0,1) {$+\;+\;+$};
			\node[text=blue, font=\scriptsize, inner sep=0pt] at (0,-0.78) {$-\;-\;-$};
		}
}
%---------------------------------------------------------
\begin{subfigure}[t]{0.45\linewidth}\centering
	\begin{tikzpicture}[>=latex]
		\pic at (0,0) {electretbody};
		% кожна лінія D --- одна замкнена крива: всередині вгору (від − до +), зовні --- від + до −
		\foreach \x/\X/\k/\c in {0.15/2.1/2.2/1.6, 0.45/1.55/1.5/1.2, 0.65/1.1/0.9/0.85} {
				\foreach \m in {-1,1} {
						\begin{scope}[xscale=\m]
							\draw[midarrow, blue] (\x,-1) -- (\x,1);
							\draw[midarrow, blue] (\x,1) .. controls (\x,{1+\k}) and (\X,\c) .. (\X,0)
							.. controls (\X,-\c) and (\x,{-1-\k}) .. (\x,-1);
						\end{scope}
					}
			}
	\end{tikzpicture}
	\caption{\centering Поле вектора електричної індукції $\Dfield$: лінії замкнені}
\end{subfigure}
\hfill
\begin{subfigure}[t]{0.45\linewidth}\centering
	\begin{tikzpicture}[>=latex]
		\pic at (0,0) {electretbody};
		% зовні лінії E збігаються з лініями D; всередині йдуть від + до − (вниз) і не замикаються
		\foreach \x/\X/\k/\c in {0.15/2.1/2.2/1.6, 0.45/1.55/1.5/1.2, 0.65/1.1/0.9/0.85} {
				\foreach \m in {-1,1} {
						\begin{scope}[xscale=\m]
							\draw[midarrow, red] (\x,1) -- (\x,-1);
							\draw[midarrow, red] (\x,1) .. controls (\x,{1+\k}) and (\X,\c) .. (\X,0)
							.. controls (\X,-\c) and (\x,{-1-\k}) .. (\x,-1);
						\end{scope}
					}
			}
	\end{tikzpicture}
	\caption{\centering Поле вектора напруженості електричного поля $\Efield$: усередині проти $\vect P$}
\end{subfigure}
