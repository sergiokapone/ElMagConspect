% Доменна структура поляризованого сегнетоелектрика (полікристал із шістьох зерен).
% а) до поляризації: у кожному зерні смуги з антипаралельною P (180°-стінки), P_сум = 0;
% б) після поляризації: у кожному зерні лишається один знак P, найближчий до напрямку E.
% Зерна, де вісь P повернулась на 90° (рядки 1, 5, 6 списку), показують 90°-переключення.
\def\DomPanel{%
  \foreach \angB/\angA/\wid/\xA/\yA/\xB/\yB/\xC/\yC/\xD/\yD in {
    170/ 80/0.90/  0/6  /3.6/6 /3.2/3.4/ 0/3.1,
     55/ 55/1.00/3.6/6  /6.8/6 /6.5/2.8/3.2/3.4,
    100/100/0.80/6.8/6  /10/6  /10/3.3 /6.5/2.8,
    120/120/1.00/  0/3.1/3.2/3.4/3.9/0 / 0/0,
     15/105/0.85/3.2/3.4/6.5/2.8/6.6/0 /3.9/0,
    145/ 55/0.95/6.5/2.8/10/3.3/10/0  /6.6/0}
  {
    \ifnum\DomMode=0 \pgfmathsetmacro{\ang}{\angB}\else \pgfmathsetmacro{\ang}{\angA}\fi
    \pgfmathsetmacro{\cx}{(\xA+\xB+\xC+\xD)/4}
    \pgfmathsetmacro{\cy}{(\yA+\yB+\yC+\yD)/4}
    \begin{scope}
      \clip (\xA,\yA) -- (\xB,\yB) -- (\xC,\yC) -- (\xD,\yD) -- cycle;
      \fill[gray!8] (\xA,\yA) -- (\xB,\yB) -- (\xC,\yC) -- (\xD,\yD) -- cycle;
      \begin{scope}[shift={(\cx,\cy)}, rotate=\ang-90]
        \ifnum\DomMode=0
          \foreach \n in {-9,...,9}
            \draw[domwall] ({\n*\wid},-8) -- ({\n*\wid},8);
        \fi
        \foreach \n in {-9,...,8}{
          \ifnum\DomMode=0
            \pgfmathtruncatemacro{\sg}{mod(\n+18,2)}
          \else
            \def\sg{0}
          \fi
          \pgfmathsetmacro{\uu}{(\n+0.5)*\wid}
          \foreach \vv in {-7,-6.5,...,7}{
            \pgfmathsetmacro{\X}{\cx+\uu*cos(\ang-90)-\vv*sin(\ang-90)}
            \pgfmathsetmacro{\Y}{\cy+\uu*sin(\ang-90)+\vv*cos(\ang-90)}
            \pgfmathsetmacro{\dA}{-((\xB-\xA)*(\Y-\yA)-(\yB-\yA)*(\X-\xA))/veclen(\xB-\xA,\yB-\yA)}
            \pgfmathsetmacro{\dB}{-((\xC-\xB)*(\Y-\yB)-(\yC-\yB)*(\X-\xB))/veclen(\xC-\xB,\yC-\yB)}
            \pgfmathsetmacro{\dC}{-((\xD-\xC)*(\Y-\yC)-(\yD-\yC)*(\X-\xC))/veclen(\xD-\xC,\yD-\yC)}
            \pgfmathsetmacro{\dD}{-((\xA-\xD)*(\Y-\yD)-(\yA-\yD)*(\X-\xD))/veclen(\xA-\xD,\yA-\yD)}
            \pgfmathparse{min(min(\dA,\dB),min(\dC,\dD))}
            \ifdim\pgfmathresult pt>0.45pt
              \ifnum\sg=0
                \draw[dompol] (\uu,\vv-0.3) -- (\uu,\vv+0.3);
              \else
                \draw[dompol] (\uu,\vv+0.3) -- (\uu,\vv-0.3);
              \fi
            \fi
          }
        }
      \end{scope}
    \end{scope}
    \draw[domgrain] (\xA,\yA) -- (\xB,\yB) -- (\xC,\yC) -- (\xD,\yD) -- cycle;
  }
  \draw[line width=1.4pt] (0,0) rectangle (10,6);
}
\resizebox{\linewidth}{!}{%
\begin{tikzpicture}[
  >={Stealth[length=2.6mm,width=2.2mm]},
  dompol/.style={red!80!black, line width=1.3pt, ->},
  domwall/.style={black!55, line width=0.7pt, dashed},
  domgrain/.style={black, line width=1.3pt}
]
\def\DomMode{0}
\begin{scope}
  \DomPanel
  \node[below] at (5,-0.1) {а) до поляризації};
\end{scope}
\def\DomMode{1}
\begin{scope}[xshift=12.5cm]
  \DomPanel
  \node[below] at (5,-0.1) {б) після поляризації};
\end{scope}
\draw[blue!70!black, line width=2.2pt, ->] (11.25,1) -- (11.25,5);
\node[blue!70!black] at (11.25,5.6) {$\Efield$};
\end{tikzpicture}}
