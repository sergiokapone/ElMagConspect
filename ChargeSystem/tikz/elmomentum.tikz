\begin{tikzpicture}[>=Stealth, scale=1.5,
	chp/.style={circle, ball color=red!85!black, minimum size=5mm, inner sep=0pt, text=white, font=\bfseries\small},
	chn/.style={circle, ball color=blue!85!black, minimum size=5mm, inner sep=0pt, text=white, font=\bfseries\small},
	posvec/.style={->, line width=1pt, teal!80!black},
	armvec/.style={->, line width=1pt, black}]
	\draw[->] (0,0) -- ++(1, 0) node[below] {$y$};
	\draw[->] (0,0) -- ++(0, 1) node[above] {$z$};
	\draw[->] (0,0) -- (-135:0.8) node[below] {$x$};

	\node[chn] (qn) at (1,2) {\mathstrut$-$};
	\node[chp] (qp) at (2.5,1.75) {\mathstrut$+$};

	\draw[posvec] (0,0) -- (qp) node[pos=0.5, below right, text=black] {$\vect{r}_+$};
	\draw[posvec] (0,0) -- (qn) node[pos=0.55, right, text=black] {$\vect{r}_-$};
	\draw[armvec] (qn) -- node[above] {$\symbfscr{l}$} (qp);
\end{tikzpicture}
