\begin{tikzpicture}[>=latex, scale=1.5]
	\draw[->] (0,0) -- ++(1, 0) node[below] {$y$};
	\draw[->] (0,0) -- ++(0, 1) node[above] {$z$};
	\draw[->] (0,0) -- (-135:0.8) node[below] {$x$};

	\node [circle, ball color=blue, inner sep=0pt, text=white,
		font=\scriptsize]
	(qn) at (1,2) {\mathstrut$-$};

	\node [circle, ball color=red, inner sep=0pt, text=white,
		font=\scriptsize] (qp) at (2.5,1.75) {\mathstrut$+$};

	\draw[->, red, thick] (0,0) -- (qp) node[pos=0.5, above, text=black] {$\vect{r}_+$};
	\draw[->, red, thick] (0,0) -- (qn) node[pos=0.5, above, text=black] {$\vect{r}_-$};
	\draw[->, thick, gray] (qn) -- node[above] {$\vect{\ell}$} (qp);
\end{tikzpicture}