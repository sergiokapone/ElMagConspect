\begin{tikzpicture}[>=latex,
    chp/.style = {circle, ball color=red!85!black, minimum size=3.5mm, inner sep=0pt, font=\bfseries\tiny\mathstrut, text=white},
    chn/.style = {circle, ball color=blue!85!black, minimum size=3.5mm, inner sep=0pt, font=\bfseries\tiny\mathstrut, text=white},
]
    \coordinate (O) at (0, 0, 0);
    \draw[->] (O) -- ++(0, 2, 0) node[above] {$z$};
    \draw[->] (O) -- ++(0, 0, 4) node[left]  {$x$};
    \draw[->] (O) -- ++(2, 0, 0) node[below] {$y$};

    \pgfmathsetseed{42}

    % Об'ємна область з радіальним затіненням
    \shade[shading=radial, inner color=gray!80!white, outer color=gray!25!white, opacity=0.6] 
        (0, 0, 0) plot[domain=0:360, samples=40, smooth cycle] ({\x}:{0.2*rnd + 1.4});

    % Точка спостереження P
    \node[circle, inner sep=0.5, fill] (P) at (xyz polar cs:angle=45, x radius=10, y radius=3) {};

    % Точкові заряди
    \foreach \i/\angle/\xrad/\yrad/\type/\sign in {
        1/160/1/2/chp/+,
        2/180/1.2/1/chn/-,
        3/90/0/0.75/chp/+,
        4/00/1.2/0/chn/-,
        5/270/0.75/1/chp/+,
        6/215/1/1.1/chn/-,
        7/-30/1/1/chn/-,
        8/-20/0.1/0.3/chp/+
    } {
        \node[\type] (q\i) at (xyz polar cs:angle=\angle, x radius=\xrad, y radius=\yrad) {$\sign$};
    }

    % Вектори та підписи
    \draw[->, line width=1pt, teal!80!black] (O) -- (q1) node[anchor=north east, text=black, pos=0.4, inner sep=1pt] {$\vect{r}_i$};
    \node[above] at (q1) {$q_i$};
    \draw[->, gray!70!black] (q1) -- node[above, sloped] {$\vect{r} - \vect{r}_i$} (P);
    \draw[->, line width=1pt, teal!80!black] (O) -- (P) node[below, sloped, pos=0.8] {$\vect{r}$};
    \node[right] at (P) {$P$};

    % Пояснювальний текст
    \node[font=\scriptsize\itshape, text width=1.5cm, align=center] (T) at (3, 0, 0) {Система\\ зарядів};
    \node (I) at (xyz polar cs:angle=-45, x radius=1.5, y radius=1.5) {};
    \draw[->] (T.south) to[out=-90, in=45] (I);

\end{tikzpicture}