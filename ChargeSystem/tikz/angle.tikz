\begin{tikzpicture}[>=Stealth, scale=2,
	field/.style={line width=0.5pt, red!60, midarrow},
	chp/.style={circle, ball color=red!85!black, minimum size=5mm, inner sep=0pt, text=white, font=\bfseries\small},
	chn/.style={circle, ball color=blue!85!black, minimum size=5mm, inner sep=0pt, text=white, font=\bfseries\small},
	pvec/.style={->, line width=1.2pt, black}]
	\foreach \y in {-2,...,2}{
			\draw[field] plot[domain=1:4] (\x, 0.2*\y);
		}
	\node[right, font=\small] at (4, 0.4) {$\Efield$};
	\node[chn] (qn) at (2,0.25) {\mathstrut$-$};
	\node[chp] (qp) at (3,-0.25) {\mathstrut$+$};
	\draw[pvec] (qn) -- node[anchor=north east, inner sep=2pt, fill=white] {$\vect{p}$} (qp);
\end{tikzpicture}
