\begin{tikzpicture}[>=Stealth, scale=1.5,
	chp/.style={circle, ball color=red!85!black, minimum size=5mm, inner sep=0pt, text=white, font=\bfseries\small},
	chn/.style={circle, ball color=blue!85!black, minimum size=5mm, inner sep=0pt, text=white, font=\bfseries\small},
	posvec/.style={->, line width=1pt, teal!80!black},
	pvec/.style={->, line width=1.2pt, black}]
	\draw[->] (0,0) -- ++(2, 0) node[below] {$y$};
	\draw[->] (0,0) -- ++(0, 2) node[above] {$z$};
	\draw[->] (0,0) -- (-135:1.8) node[below] {$x$};

	\node[chn] (qn) at (-1,0) {\mathstrut$-$};
	\node[chp] (qp) at (+1,0) {\mathstrut$+$};
	\draw[pvec] (qn) -- (qp) node[pos=0.6, below, text=black] {$\vect{p}$};

	\coordinate (P) at (55:5);
	\fill (P) circle (1.2pt);
	\node[right] at (P) {$P$};

	\draw[->, gray!70!black] (qn) -- node[pos=0.7, left] {$\vect{r}-\vect{r}_-$} (P);
	\draw[->, gray!70!black] (qp) -- node[right] {$\vect{r}-\vect{r}_+$} (P);
	\draw[posvec] (0,0) -- node[left] {$\vect{r}$} (P);
\end{tikzpicture}
