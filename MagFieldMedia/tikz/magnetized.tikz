% Намагнічений циліндр (гіпотеза Ампера): усі молекулярні струми з моментами вздовж B (вгору).
% Циліндр стоїть по центру (x=0); габарити однакові з unmagnetized.tikz.
\providecommand{\ampereloop}[3]{%
  % #1,#2 -- центр; #3 -- кут напряму магнітного моменту (град.); контур лежить у площині, перпендикулярній до моменту
  \begin{scope}[shift={(#1,#2)},rotate=#3]
    \draw[violet!70!black,thick] (0,0) ellipse [x radius=.11,y radius=.3];
    \draw[violet!70!black,thick,-{Stealth[length=2mm]}]
      ({.11*cos(170)},{.3*sin(170)}) arc [start angle=170,end angle=195,x radius=.11,y radius=.3];
    \draw[black,thick,-{Stealth[length=2.4mm]}] (0,0) -- (.55,0);
  \end{scope}%
}
\begin{tikzpicture}[scale=.9]
  \def\R{1.3}\def\e{.4}\def\H{3.6}
  \useasboundingbox (-2.4,-1) rectangle (2.4,5.5);
  \def\body{(-\R,0) arc [start angle=180,end angle=360,x radius=\R,y radius=\e] -- (\R,\H)
    arc [start angle=0,end angle=180,x radius=\R,y radius=\e] -- cycle}

  % тіло: південна (синя) половина знизу, північна (червона) зверху
  \begin{scope}
    \clip \body;
    \shade[left color=blue!55!cyan!70,middle color=cyan!35!white,right color=blue!55!cyan!70]
      (-3,-1) rectangle (3,\H+1);
    \begin{scope}
      \clip (-3,6) -- (-3,1.8) -- (-\R,1.8)
        arc [start angle=180,end angle=360,x radius=\R,y radius=\e] -- (3,1.8) -- (3,6) -- cycle;
      \shade[left color=red!65!orange!70,middle color=red!25!orange!30,right color=red!65!orange!70]
        (-3,-1) rectangle (3,\H+1);
    \end{scope}
  \end{scope}

  % молекулярні струми в товщі (усі моменти вгору)
  \foreach \x in {-.8,0,.8}
    \foreach \y in {.6,1.3,2.0,2.7}
      {\ampereloop{\x}{\y}{90}}

  % верхня грань
  \shade[inner color=red!5,outer color=red!45!orange]
    (0,\H) ellipse [x radius=\R,y radius=\e];
  \foreach \x in {-.65,.65,0}
    {\ampereloop{\x}{\H}{90}}

  % поле B: напрям S -> N (вгору), симетрично відносно осі циліндра
  \foreach \x in {-1.9,-.95,0,.95,1.9}
    \draw[blue!60!black,thick,
          postaction={decorate},
          decoration={markings,
            mark=at position 0.2 with {\arrow{Stealth[length=2.6mm]}},
            mark=at position 0.55 with {\arrow{Stealth[length=2.6mm]}},
            mark=at position 0.95 with {\arrow{Stealth[length=2.6mm]}}}]
      (\x,-.9) -- (\x,4.9);
  \node[above] at (0,4.9) {$\vect B$};
  \node[font=\bfseries,red!60!black] at (2.2,3.4) {N};
  \node[font=\bfseries,blue!60!black] at (2.2,.5) {S};
\end{tikzpicture}
