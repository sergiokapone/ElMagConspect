\begin{tikzpicture}[scale=1.2, >=Stealth]
  % Пучок частинок та вектор v0
  \draw[thick, ->] (-1.5, 0) -- (-0.3, 0) node[above=2pt] {$\mathbf{v}_0$};
  \draw[thick] (-0.3, 0) -- (0, 0);

  % Пунктирна вісь x
  \draw[dashed, ->] (0, 0) -- (8.2, 0) node[below] {$x$};

  % Пластини конденсатора (К)
  \draw[line width=5.5pt, blue] (0, 0.7) -- (3, 0.7);
  \draw[line width=5.5pt, red] (0, -0.7) -- (3, -0.7);
  \foreach \x in {0, ..., 6}
    {
        \draw[red!50, ->] ({0.45*\x+0.1}, -0.65) -- ++(0, 1.3);
    }
%  \node at (1.5, 1.1) {\Large К};



  % Траєкторія: парабола всередині [0,3], далі пряма лінія [3, 7.5]
  \draw[thick, domain=0:3, samples=50] plot (\x, {0.05*\x*\x});
  \draw[thick, decoration={markings, mark=at position 0.55 with {\arrow{>}}}, postaction={decorate}]
    (3, 0.45) -- (7.5, 1.8);

  % Кут alpha
  \draw (2.8, 0) arc (0:16.7:1.3) node[midway, right=2pt] {$\alpha$};

  % Екран (вертикальна вісь y)
  \draw[thick, ->] (7.5, -1.0) -- (7.5, 2.3) node[right] {$y$};
  \node[right] at (7.5, 0.3) {$0$};
%  \node[below right] at (7.5, -1.0) {\Large Э};

  % Розмірні лінії знизу (l та L)
  \draw[dashed, gray] (0, -0.7) -- (0, -1.6);
  \draw[dashed, gray] (3, -0.7) -- (3, -1.6);
  \draw[dashed, gray] (7.5, 0)  -- (7.5, -1.6);

  \draw[<->] (0, -1.4) -- (3, -1.4) node[midway, below] {$l$};
  \draw[<->] (3, -1.4) -- (7.5, -1.4) node[midway, below] {$L$};
\end{tikzpicture}