\begin{tikzpicture}[scale=1.2, >=Stealth, line join=round, line cap=round]
  % Косокутна проєкція: глибина (вісь z) йде вгору-вліво на вектор (-0.3,0.18);
  % пучок і траєкторія лежать у серединній площині z=0.
  \def\hx{-0.3}
  \def\hy{0.18}

  % --- електронна гармата ---
  \shadedraw[top color=gray!10, bottom color=gray!70, draw=gray!70!black] (-2.5,-0.25) rectangle (-1.75,0.25);
  \filldraw[fill=gray!80!black, draw=gray!70!black] (-1.75,0) ellipse (0.07 and 0.25);

  % --- пунктирна вісь x до екрана ---
  \draw[dashed, ->] (0, 0) -- (8.1, 0) node[below] {$x$};
  \draw[dashed, gray] (8.1, 0) -- (8.5, 0);

  % --- екран (площина x=const) ---
  \filldraw[fill=gray!15, draw=gray!60!black]
    ($(7.5,-1)-(\hx,\hy)$) -- ($(7.5,-1)+(\hx,\hy)$) -- ($(7.5,2.3)+(\hx,\hy)$) -- ($(7.5,2.3)-(\hx,\hy)$) -- cycle;
  \filldraw[fill=gray!35, draw=gray!60!black]
    ($(7.5,2.3)-(\hx,\hy)$) -- ($(7.5,2.3)+(\hx,\hy)$) -- ($(7.62,2.3)+(\hx,\hy)$) -- ($(7.62,2.3)-(\hx,\hy)$) -- cycle;

  % --- нижня обкладинка (+): верхня, передня й ліва грані ---
  \filldraw[fill=red!20, draw=red!60!black]
    ($(0,-0.8)-(\hx,\hy)$) -- ($(3,-0.8)-(\hx,\hy)$) -- ($(3,-0.8)+(\hx,\hy)$) -- ($(0,-0.8)+(\hx,\hy)$) -- cycle;
  \filldraw[fill=red!45, draw=red!60!black]
    ($(0,-0.8)-(\hx,\hy)$) -- ($(3,-0.8)-(\hx,\hy)$) -- ($(3,-0.92)-(\hx,\hy)$) -- ($(0,-0.92)-(\hx,\hy)$) -- cycle;
  \filldraw[fill=red!35, draw=red!60!black]
    ($(0,-0.8)-(\hx,\hy)$) -- ($(0,-0.8)+(\hx,\hy)$) -- ($(0,-0.92)+(\hx,\hy)$) -- ($(0,-0.92)-(\hx,\hy)$) -- cycle;
  \node[red!60!black, font=\footnotesize] at ($(2.5,-0.8)-0.5*(\hx,\hy)$) {$+$};

  % --- силові лінії поля E: два ряди по глибині ---
  \foreach \x in {0.35, 0.8, ..., 2.7} {
    \draw[red!55, ->] ($(\x,-0.7)+0.65*(\hx,\hy)$) -- ($(\x,0.55)+0.65*(\hx,\hy)$);
  }
  \foreach \x in {0.35, 0.8, ..., 2.7} {
    \draw[red!55, ->] ($(\x,-0.7)-0.65*(\hx,\hy)$) -- ($(\x,0.55)-0.65*(\hx,\hy)$);
  }
  \node[red!60!black, right=1pt] at ($(2.7,-0.1)-0.65*(\hx,\hy)$) {$\Efield$};

  % --- траєкторія: парабола в конденсаторі, далі пряма до екрана ---
  \draw[thick, domain=0:3, samples=50] plot (\x, {0.05*\x*\x});
  \draw[thick, decoration={markings, mark=at position 0.55 with {\arrow{>}}}, postaction={decorate}]
    (3, 0.45) -- (7.5, 1.8);
  % продовження прямої назад до осі: перетин у точці x = l/2
  \draw[dashed, gray] (1.5, 0) -- (3, 0.45);
  % пучок до конденсатора
  \draw[thick, ->] (-1.7, 0) -- (-0.3, 0) node[above=2pt] {$\vect{v}_0$};
  \draw[thick] (-0.3, 0) -- (0, 0);

  % частинка (q>0) і пляма на екрані
  \node[circle, ball color=red!60, inner sep=0pt, minimum size=7pt] at (1.0, 0.05) {};
  \shade[inner color=orange!80!yellow, outer color=orange!0] (7.5, 1.8) circle (0.17);
  \fill[red!70!black] (7.5, 1.8) circle (0.04);
  \fill (7.5, 0) circle (0.035);
  \node[font=\small, below right=-1pt] at (7.5, 0) {$0$};

  % --- верхня обкладинка (-): верхня, передня й ліва грані ---
  \filldraw[fill=blue!20, draw=blue!60!black]
    ($(0,0.92)-(\hx,\hy)$) -- ($(3,0.92)-(\hx,\hy)$) -- ($(3,0.92)+(\hx,\hy)$) -- ($(0,0.92)+(\hx,\hy)$) -- cycle;
  \filldraw[fill=blue!40, draw=blue!60!black]
    ($(0,0.8)-(\hx,\hy)$) -- ($(3,0.8)-(\hx,\hy)$) -- ($(3,0.92)-(\hx,\hy)$) -- ($(0,0.92)-(\hx,\hy)$) -- cycle;
  \filldraw[fill=blue!30, draw=blue!60!black]
    ($(0,0.8)-(\hx,\hy)$) -- ($(0,0.8)+(\hx,\hy)$) -- ($(0,0.92)+(\hx,\hy)$) -- ($(0,0.92)-(\hx,\hy)$) -- cycle;
  \node[blue!60!black, font=\footnotesize] at ($(2.5,0.92)-0.5*(\hx,\hy)$) {$-$};

  % --- кут alpha ---
  \draw (2.8, 0) arc (0:16.7:1.3) node[midway, right=2pt] {$\alpha$};

  % --- зміщення y на екрані ---
  \draw[dashed, gray] (7.5, 1.8) -- (8.5, 1.8);
  \draw[<->] (8.5, 0) -- (8.5, 1.8) node[midway, right] {$y$};

  % --- розмірні лінії знизу (l та L) ---
  \draw[dashed, gray] (0, -1.2) -- (0, -1.65);
  \draw[dashed, gray] (3, -1.2) -- (3, -1.65);
  \draw[dashed, gray] (7.5, -1.2) -- (7.5, -1.65);

  \draw[<->] (0, -1.5) -- (3, -1.5) node[midway, below] {$l$};
  \draw[<->] (3, -1.5) -- (7.5, -1.5) node[midway, below] {$L$};
\end{tikzpicture}
