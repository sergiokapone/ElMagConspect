    % генератор
    \draw (-0.15,3.0) -- (-0.15,3.90) -- (-0.35,3.90);
    \draw (0.15,3.0) -- (0.15,3.90) -- (0.35,3.90);
    \node[circle, draw, fill=white, inner sep=0pt, minimum size=14pt] at (0,3.90) {$\sim$};
