        arc[start angle=90, end angle=-90, radius=2.268]
        -- (-0.150,-2.719)
        arc[start angle=-90, end angle=-270, radius=2.333]
        -- (0.150,1.948)
        arc[start angle=90, end angle=-90, radius=2.397]
        -- (-0.150,-2.847)
        arc[start angle=-90, end angle=-270, radius=2.460]
