        arc[start angle=-90, end angle=-270, radius=1.739]
        -- (0.150,1.365)
        arc[start angle=90, end angle=-90, radius=1.824]
        -- (-0.150,-2.284)
        arc[start angle=-90, end angle=-270, radius=1.905]
        -- (0.150,1.527)
        arc[start angle=90, end angle=-90, radius=1.983]
        -- (-0.150,-2.439)
        arc[start angle=-90, end angle=-270, radius=2.058]
        -- (0.150,1.677)
        arc[start angle=90, end angle=-90, radius=2.130]
        -- (-0.150,-2.584)
        arc[start angle=-90, end angle=-270, radius=2.200]
