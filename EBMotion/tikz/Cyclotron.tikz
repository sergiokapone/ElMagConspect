        arc[start angle=90, end angle=-90, radius=1.455]
        -- (-0.150,-1.925)
        arc[start angle=-90, end angle=-270, radius=1.556]
        -- (0.150,1.186)
        arc[start angle=90, end angle=-90, radius=1.650]
