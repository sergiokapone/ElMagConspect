    \filldraw[fill=gray!15, draw=black, thick] (-0.15,3.0) arc[start angle=90, end angle=270, radius=3.0] -- cycle;
    \node at (2.2,2.2) {Д$_1$};
    \node at (-2.2,2.2) {Д$_2$};
    % траєкторія
