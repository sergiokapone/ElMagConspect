\begin{tikzpicture}[>=latex]

	%% ------------------- основний рисунок -------------------
	% області середовищ
	\fill[blue!8] (-4,0) rectangle (4,2.7);
	\fill[yellow!8] (-4,-2.3) rectangle (4,0);

	% межа розділу
	\draw[very thick] (-4,0) -- (4,0);
	\node[left] at (-4.1,1.5) {$n_2$};
	\node[left] at (-4.1,-1.3) {$n_1$};

	% осі (x --- углиб другого середовища, y --- вздовж межі)
	\draw[->] (0,0) -- (0,3.0) node[above] {$x$};
	\draw[->] (-3.8,0) -- (4.0,0) node[right] {$y$};

	% падаючий і повністю відбитий промені (i > i_b)
	\draw[->, thick, red!70!black] (-2.6,-2.1) -- (0,0);
	\draw[->, thick, red!70!black] (0,0) -- (2.6,-2.1);
	\draw[dashed] (0,-2.4) -- (0,-0.15);
%	\draw (0,-0.75) arc (255:285:0.75);
%	\node at (0.28,-0.75) {\scriptsize $i$};
%	\node[below, red!70!black] at (-1.5,-1.35) {\scriptsize падаючий};
%	\node[below, red!70!black] at (1.7,-1.35) {\scriptsize відбитий};

	% загасаюча хвиля: "знімки" поля на різній глибині x, амплітуда спадає
	\def\A{1.05}
	\def\K{0.55}
	\foreach \h/\op in {0.05/1, 0.65/0.65, 1.3/0.4, 2.0/0.22} {
		\draw[blue!55!black, thick, opacity=\op, domain=-3.6:3.6, samples=140]
		plot (\x, {\h + \A*exp(-\K*\h)*cos(\x*70)});
	}

	% напрям поширення хвилі -- вздовж межі, k''
	\draw[->, thick, blue!55!black] (2.6,-1.2) -- ++(0.9,0)
	node[right] {$\vect{k}''$};

	% пунктирна огинаюча +-A e^{-Kx}, щоб зв'язати з інсетом
	\draw[blue!40!black, dashed, domain=0:2.4, samples=60]
	plot ({\A*exp(-\K*\x)}, {\x}) ;
	\draw[blue!40!black, dashed, domain=0:2.4, samples=60]
	plot ({-\A*exp(-\K*\x)}, {\x}) ;

