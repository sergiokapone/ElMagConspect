% Циліндричний (коаксіальний) конденсатор в аксіальному магнітному полі: E, B і вектор Пойнтінга
% Проєкція та палітра -- як на рис. capacitor-poynting.tikz (розділ MaxwellEqns):
% кола в площині xy -- еліпси з горизонтальною великою віссю; що далі від глядача, те раніше.
% B напрямлене вниз, тож Pi = (c/4pi) E x B циркулює проти годинникової стрілки (дивлячись зверху).
\begin{tikzpicture}[x={(1cm,0cm)}, y={(0cm,0.33cm)}, z={(0cm,1cm)}, >=Latex]
  \tikzset{Emid/.style={postaction={decorate, decoration={markings, mark=at position 0.55 with {\arrow{Latex[scale=1.0]}}}}}}

  \def\R{2.6}      % радіус зовнішньої обкладки
  \def\r{0.4}     % радіус внутрішньої обкладки
  \def\H{3.2}      % висота конденсатора (h)
  \def\Rp{1.35}    % радіус кола вектора Пойнтінга
  \def\zm{1.6}     % висота, на якій намальовано циркуляцію Pi

  % ================= ЗОВНІШНЯ ОБКЛАДКА: ЗАДНЯ ЧАСТИНА (відкрита труба) =================
  \draw[gray!60, dashed] (\R,0,0) arc (0:180:\R);

  % ================= ЕЛЕКТРИЧНЕ ПОЛЕ E (ЗАДНІ ЛІНІЇ) =================
  \foreach \z in {0.8, 2.4}
    \foreach \a in {40, 80, 100, 140}
      \draw[efield!45, thick, Emid] ({\r*cos(\a)}, {\r*sin(\a)}, \z) -- ({\R*cos(\a)}, {\R*sin(\a)}, \z);

  % ================= ВЕКТОР ПОЙНТІНГА: ЗАДНЯ ЧАСТИНА (пунктир) =================
  \draw[ffield!60, thick, dashed] (\Rp,0,\zm) arc (0:180:\Rp);

  % ================= ВНУТРІШНЯ ОБКЛАДКА (стрижень) =================
  \shade[left color=gray!55, middle color=gray!15, right color=gray!78]
    (-\r,0,\H) -- (\r,0,\H) -- (\r,0,0) arc (360:180:\r) -- cycle;
  \draw[black!60] (-\r,0,\H) -- (-\r,0,0) arc (180:360:\r) -- (\r,0,\H);
  \draw[fill=gray!25, draw=black!60] (0,0,\H) circle [radius=\r];

  % ================= ЗОВНІШНЯ ОБКЛАДКА: ПЕРЕДНЯ ПОВЕРХНЯ (напівпрозора) =================
  \shade[left color=gray!40, middle color=gray!5, right color=gray!40, opacity=0.4]
    (-\R,0,\H) -- (-\R,0,0) arc (180:360:\R) -- (\R,0,\H) arc (360:180:\R) -- cycle;

  % ================= МАГНІТНЕ ПОЛЕ B (вздовж осі, вниз) =================
  \foreach \x in {-1.9, -1.0, 1.0, 1.9}
    \draw[bfield, thick, ->] (\x,0,\H+0.9) -- (\x,0,-0.8);
  \node[bfield, font=\bfseries, right] at (1.9, 0, \H+0.9) {$\Bfield$};

  % ================= ЕЛЕКТРИЧНЕ ПОЛЕ E (ПЕРЕДНІ ЛІНІЇ) =================
  \foreach \z in {0.8, 2.4}
    \foreach \a in {215, 250, 290, 325}
      \draw[efield, thick, Emid] ({\r*cos(\a)}, {\r*sin(\a)}, \z) -- ({\R*cos(\a)}, {\R*sin(\a)}, \z);
  \node[efield, font=\bfseries] at ({1.5*cos(325)+0.55}, {1.5*sin(325)}, 2.4+0.45) {$\Efield$};

  % контури труби поверх ліній E
  \draw[black!70, thick] (-\R,0,\H) -- (-\R,0,0) arc (180:360:\R) -- (\R,0,\H);
  \draw[black!70, thick] (0,0,\H) circle [radius=\R];

  % ================= ВЕКТОР ПОЙНТІНГА: ПЕРЕДНЯ ЧАСТИНА (проти годинникової стрілки) =================
  \draw[ffield, ultra thick,
        postaction={decorate, decoration={markings, mark=at position 0.58 with {\arrow{Latex[scale=1.2]}}}}]
    (-\Rp,0,\zm) arc (180:360:\Rp);
  \node[ffield, font=\bfseries, below] at ({\Rp*cos(300)}, {\Rp*sin(300)}, \zm-0.05) {$\vect\Pi$};

  % ================= ПІДПИСИ ОБКЛАДОК =================
  \node[font=\footnotesize, align=right, anchor=east] (lo) at (-\R-0.5, 0, \H*0.88) {зовнішня обкладка\\[-2pt]$(-q)$};
  \draw[thin, gray!70, ->] (lo.east) -- (-\R-0.02, 0, \H*0.88);
  \node[font=\footnotesize, align=right, anchor=east] (li) at (-\R-0.5, 0, \H*0.30) {внутрішня обкладка\\[-2pt]$(+q)$};
  \draw[thin, gray!70, ->] (li.east) -- (-\r-0.02, 0, \H*0.30);

  % ================= РОЗМІРИ =================
  \draw[<->, black, thin] (0,0,-1.05) -- (\R,0,-1.05) node[midway, below] {$R$};
  \draw[gray!50, dotted] (0,0,0) -- (0,0,-1.15);
  \draw[gray!50, dotted] (\R,0,0) -- (\R,0,-1.15);
  \draw[<->, black, thin] (\R+0.5, 0, 0) -- (\R+0.5, 0, \H) node[midway, right] {$h$};
  \draw[gray!50, dotted] (\R,0,0) -- (\R+0.7,0,0);
  \draw[gray!50, dotted] (\R,0,\H) -- (\R+0.7,0,\H);
\end{tikzpicture}
