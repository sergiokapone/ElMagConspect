% Надпровідний перехід: вище T_c опір як у нормального металу, при T_c стрибком падає до нуля;
% пунктир --- як ішов би опір без переходу (вийшов би на залишковий опір)
\begin{tikzpicture}
\begin{axis}[conspect graph,
		xlabel={$T$}, ylabel={$\varrho$},
		xmin=0, xmax=2.1, ymin=0, ymax=1.7,
		xtick={0.7}, xticklabels={$T_c$},
		ytick={0.3}, yticklabels={$\varrho_{\text{зал}}$}]
	\addplot[guide line, thick, domain=0:0.7, samples=60] {0.3 + 0.65*x*(1 - exp(-(x/0.8)^4))};
	\addplot[main curve, domain=0.7:2, samples=80] {0.3 + 0.65*x*(1 - exp(-(x/0.8)^4))};
	\draw[main curve] (axis cs:0,0) -- (axis cs:0.7,0)
		-- (axis cs:0.7,{0.3 + 0.65*0.7*(1 - exp(-(0.7/0.8)^4))});
	\draw[guide line] (axis cs:0,0.3) -- (axis cs:0.2,0.3);
	\node[above] at (axis cs:0.35,0) {$\varrho = 0$};
	\node[anchor=west, font=\footnotesize] at (axis cs:0.75,0.15) {без переходу};
	\draw[->, >=Stealth, thin] (axis cs:0.76,0.17) -- (axis cs:0.5,{0.3 + 0.65*0.5*(1 - exp(-(0.5/0.8)^4))-0.02});
	\node[below left] at (axis cs:0,0) {$0$};
\end{axis}
\end{tikzpicture}
