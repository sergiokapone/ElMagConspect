\begin{tikzpicture}
\begin{axis}[
    width=0.8\linewidth,
    height=0.5\linewidth,
    axis lines=left,
    axis line style={->, >=stealth, thick},
    xlabel={$T$},
    ylabel={$\rho$},
    xlabel style={at={(ticklabel* cs:1)}, anchor=west},
    ylabel style={at={(ticklabel* cs:1)}, anchor=south, rotate=-90},
    xmin=0, xmax=2.3,
    ymin=0, ymax=2.3,
    ytick={0.25, 0.70},
    yticklabels={$\rho_{\text{зал},1}$, $\rho_{\text{зал},2}$},
    xtick=\empty,
    % Налаштування легенди
    legend pos=north west,
    legend style={
        font=\small,
        cells={anchor=west},
        draw=gray!50,
        fill=white,
        fill opacity=0.9,
        text opacity=1,
        inner sep=5pt,
        row sep=2pt
    },
    clip=false
]

    % 1. Верхня крива: Метал з домішками
    \addplot [
        domain=0:2.1,
        samples=100,
        blue!80!black,
        very thick
    ] {0.70 + 0.65*x*(1 - exp(-pow(x/0.8, 4)))};

    \addlegendentry{З домішками ($\rho_2 = \rho_{\text{зал},2} + \rho_T$)};

%    % 2. Нижня крива: Чистий метал
    \addplot [
        domain=0:2.1,
        samples=100,
        red!85!black,
        very thick
    ] {0.25 + 0.65*x*(1 - exp(-pow(x/0.8, 4)))};
    \addlegendentry{Чистий метал ($\rho_1 = \rho_{\text{зал},1} + \rho_T$)};

    % Інформаційні елементи в легенду
    % \addlegendimage{only marks, mark=none}
    \addlegendentry{$\Delta\rho_0 = \const$ (температурний зсув)};

    % \addlegendimage{only marks, mark=none}
    % \addlegendentry{\small $T \to 0$: $\rho - \rho_0 \propto T^5$ (плато + фонони)};

    % \addlegendimage{only marks, mark=none}
    % \addlegendentry{\small $T \gg \Theta_D$: $\rho \propto T$ (лінійне зростання)};

    % Пунктирні лінії залишкового опору на осі ординат
    \draw[dotted, gray!80, thick] (axis cs:0, 0.25) -- (axis cs:0.4, 0.25);
    \draw[dotted, gray!80, thick] (axis cs:0, 0.70) -- (axis cs:0.4, 0.70);

    % Двостороння стрілка різниці залишкового опору \Delta\rho_0
    \draw[<->, >=stealth, thick, red!80!black] (axis cs:0.35, 0.25) -- (axis cs:0.35, 0.70)
        node[midway, right=1pt, font=\small\bfseries] {$\Delta\rho_0$};

\end{axis}
\end{tikzpicture}