% Правило Маттіссена: криві varrho(T) двох зразків одного металу зсунуті на різницю залишкових опорів
\begin{tikzpicture}
\begin{axis}[conspect graph,
		xlabel={$T$}, ylabel={$\varrho$},
		xmin=0, xmax=2.3, ymin=0, ymax=2.2,
		ytick={0.25, 0.70},
		yticklabels={$\varrho_{\text{зал},1}$, $\varrho_{\text{зал},2}$},
		legend pos=north west]
	% фононний внесок однаковий для обох зразків: плато при T -> 0, далі лінійне зростання
	\addplot[main curve, domain=0:2.1, samples=100] {0.70 + 0.65*x*(1 - exp(-(x/0.8)^4))};
	\addlegendentry{з~домішками}
	\addplot[second curve, domain=0:2.1, samples=100] {0.25 + 0.65*x*(1 - exp(-(x/0.8)^4))};
	\addlegendentry{чистий метал}
	\draw[guide line] (axis cs:0,0.25) -- (axis cs:0.4,0.25) (axis cs:0,0.70) -- (axis cs:0.4,0.70);
	\draw[<->, >=Stealth] (axis cs:0.3,0.25) -- (axis cs:0.3,0.70)
		node[midway, right] {$\Delta\varrho_{\text{зал}}$};
	\draw[<->, >=Stealth] (axis cs:1.9,{0.25 + 0.65*1.9}) -- (axis cs:1.9,{0.70 + 0.65*1.9})
		node[midway, right] {$\Delta\varrho_{\text{зал}}$};
	\node[below left] at (axis cs:0,0) {$0$};
\end{axis}
\end{tikzpicture}
