    % Пробій
    \draw[<-, >=stealth, dotted, thick] (axis cs:-4.4, -2.0) -- (axis cs:-4.4, -0.4);
    \node[align=center, anchor=south, font=\small, fill=white, inner sep=2pt] at (axis cs:-4.4, -0.3) {Пробій};

    % Точка нуль
    \node[anchor=north east, font=\small] at (axis cs:-0.08, -0.08) {$0$};

\end{axis}
\end{tikzpicture}