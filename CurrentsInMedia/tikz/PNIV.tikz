% ВАХ p-n-переходу за формулою Шоклі: експонента при прямому зміщенні, -I_s при зворотному,
% пробій при великій зворотній напрузі
\begin{tikzpicture}
\begin{axis}[conspect graph,
		width=0.72\linewidth, height=0.46\linewidth,
		axis lines=center,
		xlabel={$U$}, ylabel={$I$},
		xmin=-5.5, xmax=3, ymin=-3.2, ymax=6.2]
	\addplot[main curve, domain=-4.42:1.95, samples=300] {(exp(x) - 1) - 0.05/((x + 4.5)^2 + 0.02)};
	\draw[guide line] (axis cs:-4.2,-1) -- (axis cs:0,-1);
	\node[right] at (axis cs:0,-1) {$-I_s$};
	\node[anchor=north, font=\footnotesize] at (axis cs:-2.3,-1.15) {зворотне зміщення};
	\node[anchor=north, font=\footnotesize] at (axis cs:1.6,-1.7) {пряме зміщення};
	\node[anchor=east, font=\footnotesize] at (axis cs:-4.5,-2.4) {пробій};
	\node[above left] at (axis cs:0,0) {$0$};
\end{axis}
\end{tikzpicture}
