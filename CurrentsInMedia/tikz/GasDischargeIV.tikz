% ВАХ розряду в газі: омічна ділянка (0a), перехідна (ab), насичення (bc), ударна іонізація й лавини (ce), пробій (e)
\begin{tikzpicture}
\begin{axis}[conspect graph,
		xlabel={$U$}, ylabel={$I$},
		xmin=0, xmax=5.2, ymin=0, ymax=5.3,
		declare function={
			% омічна ділянка
			f1(\x) = 1.5*\x;
			% плавна зшивка з насиченням (кубічний поліном Ерміта)
			f2(\x) = 0.05*(((\x - 1.6)/0.7)^3) - 0.60*(((\x - 1.6)/0.7)^2) + 1.05*((\x - 1.6)/0.7) + 2.4;
			% струм насичення
			f3(\x) = 2.9;
			% ударна іонізація, лавини й пробій
			f4(\x) = 2.9 + 0.42*(exp(2.2*(\x - 3.7)) - 1 - 2.2*(\x - 3.7));
		}]
	\addplot[main curve, domain=0:1.6, samples=20] {f1(x)};
	\addplot[main curve, domain=1.6:2.3, samples=40] {f2(x)};
	\addplot[main curve, domain=2.3:3.7, samples=2] {f3(x)};
	\addplot[main curve, domain=3.7:4.65, samples=80] {f4(x)};

	\coordinate (A) at (axis cs:1.6, 2.4);
	\coordinate (B) at (axis cs:2.3, 2.9);
	\coordinate (C) at (axis cs:3.7, 2.9);
	\coordinate (D) at (axis cs:4.3, {f4(4.3)});
	\coordinate (E) at (axis cs:4.65, {f4(4.65)});

	\draw[guide line] (A) -- (axis cs:1.6,0) (B) -- (axis cs:2.3,0) (C) -- (axis cs:3.7,0)
		(D) -- (axis cs:4.3,0) (E) -- (axis cs:4.65,0) (axis cs:0,2.9) -- (B);

	\fill (A) circle (1.6pt) node[above left] {$a$};
	\fill (B) circle (1.6pt) node[above] {$b$};
	\fill (C) circle (1.6pt) node[above] {$c$};
	\fill (D) circle (1.6pt) node[left] {$d$};
	\fill (E) circle (1.6pt) node[left] {$e$};

	\node[left] at (axis cs:0,2.9) {$I_{\text{нас}}$};
	\node[below left] at (axis cs:0,0) {$0$};
	\node[above right] at (axis cs:2.3,0) {$U_{\text{н}}$};

	% номери ділянок
	\draw[decorate, decoration={brace, mirror, raise=2pt}] (axis cs:0,0) -- (axis cs:1.6,0) node[midway, below=4pt] {$1$};
	\draw[decorate, decoration={brace, mirror, raise=2pt}] (axis cs:1.6,0) -- (axis cs:2.3,0) node[midway, below=4pt] {$2$};
	\draw[decorate, decoration={brace, mirror, raise=2pt}] (axis cs:2.3,0) -- (axis cs:3.7,0) node[midway, below=4pt] {$3$};
	\draw[decorate, decoration={brace, mirror, raise=2pt}] (axis cs:3.7,0) -- (axis cs:4.65,0) node[midway, below=4pt] {$4$};
\end{axis}
\end{tikzpicture}
