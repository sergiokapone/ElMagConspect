% ВАХ вакуумного діода: ділянка I ~ U^{3/2} (просторовий заряд) плавно переходить у насичення
\begin{tikzpicture}
\begin{axis}[conspect graph,
		xlabel={$U$}, ylabel={$I$},
		xmin=0, xmax=8, ymin=0, ymax=5.5,
		declare function={
			% I_нас = 4,5; I = 0,5 U^{3/2} на початку
			Iva(\x) = (\x <= 0.01) ? 0 : 4.5/((1 + (4.5/(0.5*\x*sqrt(\x)))^4)^(0.25));
		}]
	\addplot[main curve, domain=0:7.5, samples=200] {Iva(x)};
	\draw[guide line] (axis cs:0,4.5) -- (axis cs:7.5,4.5);
	\node[left] at (axis cs:0,4.5) {$I_{\text{нас}}$};
	\node[below left] at (axis cs:0,0) {$0$};
	\node[anchor=west, font=\footnotesize] (law) at (axis cs:3,1.1) {$I\propto U^{3/2}$};
	\draw[->, >=Stealth, thin] (law.west) -- (axis cs:2.1,1.4);
	\node[anchor=south, font=\footnotesize] at (axis cs:5.5,4.55) {насичення};
\end{axis}
\end{tikzpicture}
