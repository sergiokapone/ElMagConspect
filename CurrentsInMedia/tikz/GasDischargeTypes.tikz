	\begin{tikzpicture}[
    scale=0.95,
    >=Stealth,
    panel/.style={draw=gray!40, fill=gray!3, rounded corners=6pt, thick},
    panel title/.style={font=\small\bfseries, color=black, anchor=north west}
]

  % ==========================================
  % а) ІСКРОВИЙ РОЗРЯД (Іскра / Блискавка)
  % ==========================================
  \begin{scope}[shift={(0, 4.2)}]
    \draw[panel] (0, 0) rectangle (6.5, 3.6);
    \node[panel title] at (0.2, 3.4) {а) Іскровий розряд};

    % Сферичні електроди
    \shade[ball color=gray!40, draw=gray!80, thick] (1.1, 1.8) circle (0.45);
    \shade[ball color=gray!40, draw=gray!80, thick] (5.4, 1.8) circle (0.45);
    
    \node[left=2pt, font=\small\bfseries] at (0.65, 1.8) {$-$};
    \node[right=2pt, font=\small\bfseries] at (5.85, 1.8) {$+$};

    % Зовнішнє сяйво каналу
    \draw[line width=5pt, violet!40, opacity=0.6, line cap=round] 
      (1.55, 1.8) -- (2.3, 2.3) -- (3.2, 1.3) -- (4.1, 2.2) -- (4.95, 1.8);

    % Основний зигзагоподібний канал іскри
    \draw[line width=2pt, cyan!90!black, line cap=round] 
      (1.55, 1.8) -- (2.3, 2.3) -- (3.2, 1.3) -- (4.1, 2.2) -- (4.95, 1.8);
    \draw[line width=0.8pt, white, line cap=round] 
      (1.55, 1.8) -- (2.3, 2.3) -- (3.2, 1.3) -- (4.1, 2.2) -- (4.95, 1.8);

    % Відгалуження (стримери)
    \draw[line width=1pt, cyan!80!black] (2.3, 2.3) -- (2.6, 2.7);
    \draw[line width=1pt, cyan!80!black] (3.2, 1.3) -- (3.5, 0.8);
    \draw[line width=1pt, cyan!80!black] (4.1, 2.2) -- (4.5, 2.6);
  \end{scope}

  % ==========================================
  % б) КОРОННИЙ РОЗРЯД (Вістря)
  % ==========================================
  \begin{scope}[shift={(7.2, 4.2)}]
    \draw[panel] (0, 0) rectangle (6.5, 3.6);
    \node[panel title] at (0.2, 3.4) {б) Коронний розряд};

    % Плаский електрод (знизу)
    \filldraw[fill=gray!35, draw=gray!80, thick] (1.0, 0.6) rectangle (5.5, 0.9);
    
    % Електрод-вістря (зверху)
    \filldraw[fill=gray!45, draw=gray!80, thick] (3.0, 3.0) -- (3.5, 3.0) -- (3.27, 1.6) -- (3.23, 1.6) -- cycle;
    \node[right=2pt, font=\small\bfseries] at (3.5, 2.8) {Вістря ($+$)};

    % Фіолтове коронне сяйво навколо вістря
    \shade[inner color=violet!80!cyan, outer color=violet!0, opacity=0.85] (3.25, 1.6) circle (0.7);
    \fill[cyan!80!white] (3.25, 1.6) circle (0.12);

    % Силові лінії поля
    \draw[gray!60, dashed, ->] (3.25, 1.4) -- (3.25, 0.9);
    \draw[gray!60, dashed, ->] (3.1, 1.4) -- (2.2, 0.9);
    \draw[gray!60, dashed, ->] (3.4, 1.4) -- (4.3, 0.9);
    
    \node[below=1pt, font=\scriptsize] at (3.25, 0.6) {Плоский електрод ($-$)};
  \end{scope}

  % ==========================================
  % в) ТЛІЮЧИЙ РОЗРЯД (Неонова трубка)
  % ==========================================
  \begin{scope}[shift={(0, 0)}]
    \draw[panel] (0, 0) rectangle (6.5, 3.6);
    \node[panel title] at (0.2, 3.4) {в) Тліючий розряд};

    % Скляна трубка
    \draw[cyan!60!black, ultra thick, fill=cyan!5] (0.8, 1.0) rectangle (5.7, 2.3);

    % Електроди
    \filldraw[fill=gray!50, draw=black, thick] (0.8, 1.2) rectangle (1.0, 2.1);
    \filldraw[fill=gray!50, draw=black, thick] (5.5, 1.2) rectangle (5.7, 2.1);
    
    \node[below=2pt, font=\scriptsize\bfseries] at (0.9, 1.0) {K ($-$)};
    \node[below=2pt, font=\scriptsize\bfseries] at (5.6, 1.0) {A ($+$)};

    % Катодне свічення
    \fill[blue!50, opacity=0.8] (1.01, 1.01) rectangle (1.2, 2.29);
    % Позитивний стовп (неонове оранжеве сяйво)
    \fill[orange!85!magenta, opacity=0.8] (2.0, 1.01) rectangle (5.49, 2.29);

    % Підписи областей
    \draw[<-, thick, black!70] (1.1, 2.3) -- (1.1, 2.7) node[above, font=\tiny\sffamily] {Катодне свічення};
    \draw[<-, thick, black!70] (3.7, 2.3) -- (3.7, 2.7) node[above, font=\tiny\sffamily] {Позитивний стовп};
  \end{scope}

  % ==========================================
  % г) ДУГОВИЙ РОЗРЯД (Електрична дуга)
  % ==========================================
  \begin{scope}[shift={(7.2, 0)}]
    \draw[panel] (0, 0) rectangle (6.5, 3.6);
    \node[panel title] at (0.2, 3.4) {г) Дуговий розряд};

    % Вугільні / металеві електроди
    \filldraw[fill=gray!70!black, draw=black, thick] (0.6, 1.3) -- (2.3, 1.3) -- (2.5, 1.65) -- (2.3, 2.0) -- (0.6, 2.0) -- cycle;
    \filldraw[fill=gray!70!black, draw=black, thick] (5.9, 1.3) -- (4.2, 1.3) -- (4.0, 1.65) -- (4.2, 2.0) -- (5.9, 2.0) -- cycle;

    % Розжарені кінці електродів
    \fill[orange!90!red] (2.2, 1.3) -- (2.5, 1.65) -- (2.2, 2.0) -- (2.3, 1.65) -- cycle;
    \fill[orange!90!red] (4.3, 1.3) -- (4.0, 1.65) -- (4.3, 2.0) -- (4.2, 1.65) -- cycle;

    % Ореол сяйва дуги
    \shade[inner color=yellow!50!orange, outer color=orange!0, opacity=0.9] (3.25, 1.65) ellipse (1.3 and 0.95);
    \shade[inner color=white, outer color=yellow!90!orange, opacity=0.95] (3.25, 1.65) ellipse (0.75 and 0.5);

    % Вигнутий яскравий канал дуги
    \draw[line width=3.5pt, yellow!20, line cap=round] (2.4, 1.65) .. controls (2.8, 2.15) and (3.7, 2.15) .. (4.1, 1.65);
    \draw[line width=1.5pt, white, line cap=round] (2.4, 1.65) .. controls (2.8, 2.15) and (3.7, 2.15) .. (4.1, 1.65);

    % Підписи
    \node[below=2pt, font=\scriptsize\bfseries] at (1.4, 1.3) {Електрод ($-$)};
    \node[below=2pt, font=\scriptsize\bfseries] at (5.1, 1.3) {Електрод ($+$)};
    \node[above=2pt, font=\small\bfseries\color{orange!80!black}] at (3.25, 2.4) {Електрична дуга};
  \end{scope}

\end{tikzpicture}