\begin{tikzpicture}[>=Stealth, font=\sffamily\small]
    % осі: струм I (по горизонталі) і напруга на клемах U (по вертикалі)
    \draw[->] (0,0) -- (4.6,0) node[below] {$I$};
    \draw[->] (0,0) -- (0,3.8) node[left] {$U$};

    % джерело напруги: мала r, U майже не залежить від I
    \draw[very thick, blue!70!black] (0,3) -- (4,2.2);
    \node[blue!70!black, below right, align=left, inner sep=2pt] at (2.7,2.3) {джерело\\напруги};
    \draw[dotted, thin] (4,0) -- (4,2.2);
    \node[below] at (4,0) {$I_{\text{к.з.}}$};
    \node[left] at (0,3) {$\emf$};

    % джерело струму: велика r, I майже не залежить від U
    \draw[very thick, red!70!black] (2.6,0) -- (2.4,3.5);
    \node[red!70!black, left, align=right] at (2.4,1.2) {джерело\\струму};
    \node[below] at (2.6,0) {$I_0$};
\end{tikzpicture}
