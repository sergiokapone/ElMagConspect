\begin{tikzpicture}[scale=1.25]
	\node  [gray!50, ground, minimum width=7cm,yshift=-0.17cm] (floor1) at (-1,0) {};
	\draw (floor1.north west) -- (floor1.north east);
	\node  [gray!50, ground, minimum width=7cm,yshift=-0.17cm] (floor2) at (1,0) {};
	\draw (floor2.north west) -- (floor2.north east);
	\draw [ball color=gray!20] (180:1) arc (180:360:1) -- cycle;
	\draw [-latex] (0,0) -- node [right] {$\frac{D}{2}$}(240:1);
	% ----------------- Рисування графіка -----------------
	\draw[-latex] (-4.4,0) -- (-4.4,5) node[right] {$\phi$};
	\draw[-latex] (-4.4,0) -- (4.2,0) node[below] {$r$};
	\draw [blue] (180:2) arc (180:360:2);
	\draw [blue] (180:2.4) arc (180:360:2.4);
	\draw[ultra thick, blue] (0,{3.5*exp(-0.6*1)+0.5}) -- +(1,0);
	\draw[ultra thick, domain=1:4,smooth,variable=\x,blue, name path = curve] plot ({\x},{3.5*exp(-0.6*\x)+0.5});

	\draw[ultra thick, gray!50] (0,{3.5*exp(-0.6*1)+0.5}) -- +(-1,0);
	\draw[ultra thick, domain=-4:-1,smooth,variable=\x,gray!50] plot ({\x},{3.5*exp(0.6*\x)+0.5});

	\path[name path global= line] (2.4,0) -- ++(0,4);
	\draw[dashed, name intersections = {of = curve and line, by = A}] (2.4,0) -- (A);
	\draw[dashed] (A) -- (A-|-4.4,0) node[below right=-3pt] {$\phi_2$};

	\path[name path global= line] (2,0) -- ++(0,4);
	\draw[dashed, name intersections = {of = curve and line, by = B}] (2,0) -- (B);
	\draw[dashed] (B) -- (B-|-4.4,0) node[above right=-3pt] {$\phi_1$};

	\draw (B-|-4.4,0) -- +(1.6,0) coordinate (P1);
	\draw (A-|-4.4,0) -- +(1.6,0) coordinate (P2);
	\draw[latex-] ([xshift=-0.2cm]P1) -- ([shift={(-0.2,0.5)}]P1);
	\draw[latex-] ([xshift=-0.2cm]P2) -- ([shift={(-0.2,-0.4)}]P2) node[anchor=north west, xshift=-0.9cm, yshift=-0.35cm] {$U_\text{крокова} = \phi_1 - \phi_2$};


	\draw (2,0) -- +(0,-2);
	\draw (2.4,0) -- +(0,-2);
	\draw[-latex] (1,-1.9) -- (2, -1.9);
	\draw[latex-]  (2.4, -1.9) -- (3.4, -1.9);
	\path (2,-1.9) -- node[below] {$\ell$} (2.4, -1.9);
	% ----------------- Рисування ЛЕП -----------------
	\begin{scope}[gray!80, line cap=round, line join=round]
		ill[white] (-0.55,0) -- (-0.09,3.65) -- (0,4.05) -- (0.09,3.65) -- (0.55,0) -- cycle;
		% ноги опори (звужуються догори) та тросова стійка
		\draw[thick] (-0.55,0) -- (-0.09,3.65) -- (0,4.05) -- (0.09,3.65) -- (0.55,0);
		% пояси (горизонтальні розпірки) і хрестові в'язі між ними
		\foreach \ya/\yb in {0/0.6, 0.6/1.2, 1.2/1.8, 1.8/2.4, 2.4/3.0, 3.0/3.65} {
			\pgfmathsetmacro{\wa}{0.55-0.46*\ya/3.65}
			\pgfmathsetmacro{\wb}{0.55-0.46*\yb/3.65}
			\draw (-\wa,\ya) -- (\wa,\ya);
			\draw (-\wa,\ya) -- (\wb,\yb) (\wa,\ya) -- (-\wb,\yb);
		}
		\draw (-0.09,3.65) -- (0.09,3.65);
		% траверси (перехрестя) з підкосами
		\draw[thick] (-0.62,3.65) -- (0.62,3.65);
		\draw[thick] (-1.1,3.15) -- (1.1,3.15);
		\draw (-0.62,3.65) -- (-0.1,3.4) (0.62,3.65) -- (0.1,3.4);
		\draw (-1.1,3.15) -- (-0.17,2.85) (1.1,3.15) -- (0.17,2.85);
		\draw (-1.1,3.15) -- (-0.14,3.4) (1.1,3.15) -- (0.14,3.4);
	\end{scope}
	% ізолятори (гірлянди) під кінцями траверс
	\foreach \x/\y in {-0.62/3.65, 0.62/3.65, -1.1/3.15, 1.1/3.15} {
		\foreach \k in {0,...,3} {
			\fill[gray!35!blue!40, draw=gray!70, line width=0.3pt] (\x-0.045,\y-0.04-0.05*\k) rectangle (\x+0.045,\y-0.08-0.05*\k);
		}
	}
	% дроти: цілі (з провисанням) і обірваний
	\begin{scope}[black!70, thick]
		\draw (-0.62,3.43) .. controls (-1.6,3.2) and (-3,3.2) .. (-3.8,3.45);
		\draw (-1.1,2.93) .. controls (-2,2.7) and (-3,2.7) .. (-3.8,2.95);
		\draw (1.1,2.93) .. controls (2,2.7) and (3,2.7) .. (3.8,2.95);
		% обірваний дріт: коротка петля біля ізолятора і вільний кінець, що впав на землю
		\draw[red!70!black] (0.62,3.43) .. controls (0.8,3.2) and (1.0,2.4) .. (0.85,1.4)
			.. controls (0.75,0.8) and (1.1,0.5) .. (1.0,0.02);
	\end{scope}
	% іскра в місці замикання на землю
	\draw[orange, thick, line cap=round] (1.0,0.02) -- ++(0.2,0.18) -- ++(-0.14,0) -- ++(0.24,0.22);
	% ----------------- Рисування людини (йде від опори вправо, ноги на r і r+l) -----------------
	\begin{scope}[yscale=0.8, line cap=round, line join=round]
		\coordinate (hip) at (2.2,0.62);
		\coordinate (sh)  at (2.27,1.2);
		% задня рука (за тулубом)
		\draw[red!45!black, line width=2.4pt] (sh) -- (2.13,0.95) -- (2.07,0.78);
		% ноги: задня на r, передня на r+l; стопи вперед
		\draw[blue!45!black, line width=3.6pt] (hip) -- (2.1,0.33) -- (2.0,0.05);
		\draw[blue!45!black, line width=3.6pt] (hip) -- (2.31,0.33) -- (2.4,0.05);
		\draw[black, line width=3pt] (2.0,0.03) -- +(0.1,0);
		\draw[black, line width=3pt] (2.4,0.03) -- +(0.1,0);
		% тулуб, трохи нахилений уперед
		\draw[red!70!black, line width=6.5pt] (hip) -- (sh);
		% передня рука
		\draw[red!70!black, line width=2.4pt] (sh) -- (2.40,0.97) -- (2.46,0.80);
		% шия і голова
		\draw[orange!60!black, line width=2pt] (sh) -- +(0.02,0.08);
		\filldraw[orange!60!black, draw=black!70, line width=0.5pt] ($(sh)+(0.04,0.2)$) circle (0.11);
	\end{scope}
\end{tikzpicture}
