\begin{tikzpicture}[>=Stealth, thick, font=\sffamily\small]

    % --- Параметри рисунка ---
    \def\h{5}          % Висота провідників
    \def\w{1.4}        % Ширина провідників
    \def\gap{3.0}      % Відстань між провідниками
    \def\yz{2.5}       % Висота точки спостереження

    \def\xL{\w}        % Права межа лівого провідника
    \def\xR{\w + \gap} % Ліва межа правого провідника

    \pgfmathsetmacro{\r}{\w/2}       % Півширина циліндра
    \pgfmathsetmacro{\ry}{0.3*\r}    % Овальність еліпса (3D-ефект)

    % --- 1. Металеві циліндри (зліва і справа) ---
    \foreach \x in {0, \xR} {
        % Тіло: смуговий градієнт імітує полірований метал
        \shade[left color=gray!70, right color=gray!70, middle color=white,
               draw=gray!70, line width=0.4pt]
            (\x, 0) arc (180:360:\r\space and \ry) -- (\x+\w, \h)
            arc (0:180:\r\space and \ry) -- cycle;
        % Блік уздовж твірної
        \fill[white, opacity=0.85, rounded corners=1pt]
            (\x+0.2*\w, 0.15) rectangle (\x+0.3*\w, \h-0.1);
        % Верхня кришка
        \shade[inner color=white, outer color=gray!40, draw=gray!70, line width=0.4pt]
            (\x+\r, \h) ellipse[x radius=\r, y radius=\ry];
    }

    % --- 2. Поверхневі заряди ---
    \foreach \y in {0.5, 1.5, ..., 4.5} {
        \node[red!80!black, font=\bfseries] at (\xL-0.12, \y) {+};
        \node[blue!80!black, font=\bfseries] at (\xR+0.14, \y) {--};
    }

    % --- 3. Точки прив'язки ---
    \coordinate (OL) at (\xL, \yz);
    \coordinate (OR) at ({\xR-0.15}, \yz);

    % --- 4. Силові лінії ---
    \draw[line width=0.9pt, midarrow] (OL) to[out=55, in=125] (OR);
    \foreach \y in {0.5, 1.5, 3.5, 4.5} {
        \draw[gray, line width=0.8pt, dotted, midarrow]
            (\xL, \y) to[out=50, in=130] (\xR, \y);
    }

    % --- 5. Густина струму ---
    \draw[->, red!80!black, semithick] (0.35*\w, 1.5) -- (0.35*\w, 3.5);
    \node[left] at (0.35*\w, 2.5) {$\vect{j}$};
    \draw[->, red!80!black, semithick] (\xR+0.65*\w, 4.5) -- (\xR+0.65*\w, 3.0);
    \node[right] at (\xR+0.65*\w, 3.75) {$-\vect{j}$};

    % --- 6. Вектори поля (ліворуч) ---
    \draw[->, red!80!black, semithick] ([xshift=-0.45cm]OL) -- ++(0, 1.8)
        node[left] {$\Efield'$};
    \draw[->, red!80!black, semithick] (OL) -- ++(0, 1.8) coordinate (Et_L);
    \node[above right] at (Et_L) {$\Efield_\tau$};
    \draw[->, red!80!black, semithick] (OL) -- ++(1.3, 0) coordinate (En_L);
    \node[below] at (En_L) {$\Efield_n$};
    \draw[->, red!80!black, semithick] (OL) -- ++(1.3, 1.8) coordinate (E_L);
    \node[right] at (E_L) {$\Efield$};
    \draw[dashed, thin] (En_L) -- (E_L) -- (Et_L);

    % --- 7. Вектори поля (праворуч) ---
    \draw[->, red!80!black, semithick] (OR) -- ++(0, -1.8) coordinate (Et_R);
    \node[left] at ($(OR)!0.8!(Et_R)$) {$\Efield_\tau$};
    \draw[->, red!80!black, semithick] (OR) -- ++(1.3, 0) coordinate (En_R);
    \node[above right] at (En_R) {$\Efield_n$};
    \draw[->, red!80!black, semithick] (OR) -- ++(1.3, -1.8) coordinate (E_R);
    \node[right] at (E_R) {$\Efield$};
    \draw[dashed, thin] (En_R) -- ++(0, -1.8) -- (Et_R);

\end{tikzpicture}
