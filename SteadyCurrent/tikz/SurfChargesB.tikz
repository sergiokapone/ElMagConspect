    \node[blue!80!black, font=\bfseries\scriptsize, inner sep=0] at (0.63,-1.74) {$-$};
    \end{scope}
    % струм j уздовж дроту: від «+» клеми до «−»
    \begin{scope}[-{Stealth[length=2.4mm]}, line width=1pt, green!45!black]
        \draw (1.50,-1.50) -- (1.50,-2.30);
        \draw (0.35,-5.20) -- (-0.35,-5.20);
        \draw (-1.50,-2.30) -- (-1.50,-1.50);
    \end{scope}
    \node[green!45!black, fill=white, fill opacity=0.85, text opacity=1, inner sep=1pt] at (2.25,-1.90) {$\vect j$};
    \node[anchor=north, inner sep=2pt] at (0,-5.45) {$\Efield=\vect j/\lambda$ у дроті};
    % виноска: увеличений фрагмент поверхні дроту (малюється вручну, а не через spy, щоб вектори були читабельні)
    \draw[gray, line width=0.6pt] (1.84,-3.35) circle (0.45);
    \draw[gray, line width=0.4pt] (2.29,-3.34) -- (3.80,-3.30);
    \begin{scope}
        \clip (5.60,-3.30) circle (1.8);
        \fill[white] (3.70,-5.20) rectangle (7.50,-1.40);
        \fill[gray!25] (3.70,-5.20) rectangle (4.58,-1.40);
        \fill[white, opacity=0.8] (4.05,-5.20) rectangle (4.25,-1.40);
        \fill[gray!70] (4.58,-5.20) rectangle (4.72,-1.40);
        \draw[line width=0.8pt, black!75, midarrow] (4.72,-2.30) .. controls (5.30,-2.45) and (5.70,-2.65) .. (6.60,-3.05);
        \draw[line width=0.8pt, black!75, midarrow] (4.72,-4.20) .. controls (5.30,-4.35) and (5.70,-4.55) .. (6.60,-4.95);
    \end{scope}
    \draw[gray, line width=0.6pt] (5.60,-3.30) circle (1.8);
    \begin{scope}[red!80!black, line width=0.9pt, {>={Stealth[length=2.2mm]}}, ->]
        \draw (4.72,-3.30) -- ++(1.10,0) coordinate (En);
        \draw (4.72,-3.30) -- ++(0,-0.45) coordinate (Et);
        \draw (4.72,-3.30) -- ++(1.10,-0.45) coordinate (E);
    \end{scope}
    \draw[dashed, thin, red!80!black] (En) -- (E) -- (Et);
    \node[above, red!80!black, inner sep=1pt] at ($(4.72,-3.30)!0.5!(En)$) {$\Efield_n$};
    \node[below right, red!80!black, inner sep=1pt] at (Et) {$\Efield_\tau$};
    \node[right, red!80!black, inner sep=1pt] at (E) {$\Efield$};
\end{tikzpicture}
